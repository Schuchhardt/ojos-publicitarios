---
import { TIPOS_DE_PROYECTO } from '../data/contenido';
import {
  FORMSPREE_ENDPOINT,
  TIENE_WHATSAPP,
  WHATSAPP_DISPLAY,
  whatsappUrl,
} from '../lib/config';
---

<dialog class="solicitud" id="solicitud" aria-labelledby="solicitud-titulo">
  <button type="button" class="cerrar" aria-label="Cerrar" data-cerrar>×</button>

  <div class="rotulo">CONVERSEMOS SOBRE TU IDEA</div>
  <h2 id="solicitud-titulo">Tu proyecto,<br />en pocas palabras.</h2>
  <p class="bajada" id="solicitud-bajada">
    Cuéntanos qué necesitas. Te respondemos con un plan concreto: qué incluye, de qué nos
    encargamos nosotros y cuánto cuesta.
  </p>

  <div class="error" id="solicitud-error" role="alert" hidden>
    <p>
      No pudimos enviar tu solicitud. Vuelve a intentarlo
      {TIENE_WHATSAPP && (
        <>
          {' '}o escríbenos por <a href={whatsappUrl()} target="_blank" rel="noopener">WhatsApp</a>
        </>
      )}.
    </p>
  </div>

  <div class="exito" id="solicitud-exito" hidden>
    <div class="exito-marca" aria-hidden="true">✓</div>
    <h3>Recibimos tu solicitud.</h3>
    <p>Te responde una persona del equipo el mismo día hábil.</p>
  </div>

  <form id="solicitud-form" action={FORMSPREE_ENDPOINT} method="POST" novalidate>
    <input type="hidden" name="_subject" value="Nueva solicitud — Ojos Publicitarios" />
    <!-- Honeypot anti-spam: Formspree descarta el envío si viene relleno. -->
    <input
      type="text"
      name="_gotcha"
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
      class="trampa"
    />

    <label for="solicitud-nombre">
      Tu nombre
      <input
        type="text"
        id="solicitud-nombre"
        name="nombre"
        placeholder="¿Cómo te llamas?"
        autocomplete="name"
        required
      />
    </label>

    <label for="solicitud-email">
      Tu correo
      <input
        type="email"
        id="solicitud-email"
        name="email"
        placeholder="Para responderte"
        autocomplete="email"
        required
      />
    </label>

    <label for="solicitud-telefono">
      Teléfono o WhatsApp <span class="opcional">(opcional)</span>
      <input
        type="tel"
        id="solicitud-telefono"
        name="telefono"
        placeholder="+56 9 ..."
        autocomplete="tel"
      />
    </label>

    <label for="solicitud-empresa">
      Empresa o marca <span class="opcional">(opcional)</span>
      <input
        type="text"
        id="solicitud-empresa"
        name="empresa"
        placeholder="Nombre de tu negocio"
        autocomplete="organization"
      />
    </label>

    <label for="solicitud-tipo">
      ¿Qué necesitas?
      <select id="solicitud-tipo" name="tipo">
        {TIPOS_DE_PROYECTO.map((tipo) => <option value={tipo}>{tipo}</option>)}
      </select>
    </label>

    <label for="solicitud-idea">
      Cuéntanos tu idea
      <textarea
        id="solicitud-idea"
        name="idea"
        rows="4"
        placeholder="¿Qué vendes y qué te gustaría lograr?"></textarea>
    </label>

    <button type="submit" class="boton boton-primario" id="solicitud-enviar">
      Enviar solicitud <span aria-hidden="true">↗</span>
    </button>

    <p class="aviso">Responde una persona del equipo, el mismo día hábil.</p>
  </form>

  {
    TIENE_WHATSAPP && (
      <p class="alternativa" id="solicitud-alternativa">
        ¿Prefieres escribirnos directo?{' '}
        <a href={whatsappUrl()} target="_blank" rel="noopener" data-track="whatsapp_modal">
          WhatsApp {WHATSAPP_DISPLAY}
        </a>
      </p>
    )
  }
</dialog>

<style>
  .solicitud {
    width: min(520px, calc(100vw - 32px));
    max-height: min(88vh, 820px);
    padding: clamp(24px, 4vw, 40px);
    border: 1px solid var(--acento-borde-suave);
    border-radius: 4px;
    background: var(--panel-destacado);
    color: var(--texto);
    overflow: auto;
  }

  .solicitud::backdrop {
    background: rgba(3, 9, 14, 0.78);
    backdrop-filter: blur(4px);
  }

  .cerrar {
    position: absolute;
    top: clamp(14px, 2vw, 22px);
    right: clamp(14px, 2vw, 22px);
    background: none;
    border: none;
    color: var(--texto-tenue);
    font-size: 26px;
    line-height: 1;
    padding: 0 2px;
    cursor: pointer;
  }

  .cerrar:hover {
    color: var(--acento);
  }

  .rotulo {
    font-family: var(--fuente-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--acento);
    margin-bottom: 16px;
    padding-right: 32px;
  }

  h2 {
    font-family: var(--fuente-titulo);
    font-size: clamp(26px, 3.4vw, 34px);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 14px;
  }

  .bajada {
    font-size: 15px;
    line-height: 1.6;
    color: var(--texto-apagado);
    margin: 0 0 28px;
  }

  .error {
    border: 1px solid rgba(255, 138, 122, 0.5);
    background: rgba(255, 138, 122, 0.08);
    padding: 14px 16px;
    margin-bottom: 20px;
  }

  .error p {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--texto-suave);
  }

  .exito {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 4px 0 8px;
  }

  .exito-marca {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--acento);
    color: var(--bg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
  }

  .exito h3 {
    font-family: var(--fuente-titulo);
    font-size: 21px;
    font-weight: 600;
    margin: 0;
  }

  .exito p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--texto-apagado);
    margin: 0;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  label {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--texto);
  }

  .opcional {
    font-weight: 400;
    color: var(--texto-debil);
  }

  input,
  select,
  textarea {
    width: 100%;
    padding: 13px 14px;
    background: var(--bg);
    border: 1px solid var(--linea-media);
    border-radius: var(--radio);
    color: var(--texto);
    font-family: var(--fuente-texto);
    font-size: 15px;
    font-weight: 400;
  }

  textarea {
    resize: vertical;
    min-height: 96px;
  }

  input::placeholder,
  textarea::placeholder {
    color: var(--texto-debil);
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--acento);
  }

  :is(input, textarea)[aria-invalid='true'] {
    border-color: #ff8a7a;
  }

  /* Honeypot: fuera de la vista pero disponible para los bots. */
  .trampa {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  button[type='submit'] {
    justify-content: center;
    margin-top: 4px;
  }

  button[type='submit']:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .aviso {
    font-family: var(--fuente-mono);
    font-size: 11px;
    line-height: 1.7;
    color: var(--texto-debil);
    margin: 0;
  }

  .alternativa {
    font-size: 14px;
    line-height: 1.6;
    color: var(--texto-apagado);
    margin: 22px 0 0;
    padding-top: 18px;
    border-top: 1px solid var(--linea-media);
  }
</style>

<script>
  import { emailValido, nombreValido, primerError } from '../lib/formulario';

  const dialogo = document.querySelector<HTMLDialogElement>('dialog.solicitud');
  const formulario = document.getElementById('solicitud-form') as HTMLFormElement | null;

  if (dialogo && formulario) {
    const nombre = document.getElementById('solicitud-nombre') as HTMLInputElement | null;
    const email = document.getElementById('solicitud-email') as HTMLInputElement | null;
    const enviar = document.getElementById('solicitud-enviar') as HTMLButtonElement | null;
    const error = document.getElementById('solicitud-error');
    const exito = document.getElementById('solicitud-exito');
    const bajada = document.getElementById('solicitud-bajada');
    const alternativa = document.getElementById('solicitud-alternativa');
    const textoBoton = enviar?.innerHTML ?? '';

    document.querySelectorAll<HTMLElement>('[data-abrir-solicitud]').forEach((boton) => {
      boton.addEventListener('click', () => {
        dialogo.showModal();
        nombre?.focus();
      });
    });

    dialogo.querySelector('[data-cerrar]')?.addEventListener('click', () => dialogo.close());

    // Clic fuera del contenido = cerrar.
    dialogo.addEventListener('click', (evento) => {
      if (evento.target === dialogo) dialogo.close();
    });

    formulario.addEventListener('submit', async (evento) => {
      evento.preventDefault();
      error?.setAttribute('hidden', '');

      const fallo = primerError([
        { el: nombre, ok: nombreValido(nombre?.value ?? ''), mensaje: 'Escribe tu nombre.' },
        {
          el: email,
          ok: emailValido(email?.value ?? ''),
          mensaje: 'Revisa tu correo: no parece una dirección válida.',
        },
      ]);
      if (fallo) {
        fallo.el?.focus();
        fallo.el?.reportValidity?.();
        return;
      }

      if (enviar) {
        enviar.disabled = true;
        enviar.textContent = 'Enviando…';
      }

      try {
        const respuesta = await fetch(formulario.action, {
          method: 'POST',
          body: new FormData(formulario),
          headers: { Accept: 'application/json' },
        });

        if (respuesta.ok) {
          formulario.hidden = true;
          bajada?.setAttribute('hidden', '');
          alternativa?.setAttribute('hidden', '');
          exito?.removeAttribute('hidden');
          window.track?.('solicitud_enviada', { label: 'formspree' });
        } else {
          error?.removeAttribute('hidden');
          window.track?.('solicitud_error', { label: String(respuesta.status) });
        }
      } catch {
        error?.removeAttribute('hidden');
        window.track?.('solicitud_error', { label: 'red' });
      } finally {
        if (enviar) {
          enviar.disabled = false;
          enviar.innerHTML = textoBoton;
        }
      }
    });
  }
</script>
