---
import { HOME, type Idioma } from '../data/home';
import { FORMSPREE_ENDPOINT } from '../lib/config';

interface Props {
  idioma?: Idioma;
}

const { idioma = 'es' } = Astro.props;
const t = HOME[idioma];
const c = t.solicitud;
---

<dialog
  class="solicitud"
  id="solicitud"
  aria-labelledby="solicitud-titulo"
  data-error-nombre={c.errorNombre}
  data-error-email={c.errorEmail}
  data-enviando={c.enviando}
>
  <button type="button" class="cerrar" aria-label={c.cerrar} data-cerrar>×</button>

  <div class="rotulo">{c.rotulo}</div>
  <h2 id="solicitud-titulo">{c.titulo}</h2>
  <p class="bajada" id="solicitud-bajada">{c.bajada}</p>

  <div class="error" id="solicitud-error" role="alert" hidden>
    <p>{c.error}</p>
  </div>

  <div class="exito" id="solicitud-exito" hidden>
    <div class="exito-marca" aria-hidden="true">✓</div>
    <h3>{c.exito}</h3>
    <p>{t.respuestaPromesa}</p>
  </div>

  <form id="solicitud-form" action={FORMSPREE_ENDPOINT} method="POST" novalidate>
    <input type="hidden" name="_subject" value={c.asunto} />
    <input type="hidden" name="idioma" value={idioma} />
    <!-- Honeypot anti-spam: Formspree descarta el envío si viene relleno. -->
    <input
      type="text"
      name="_gotcha"
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
      class="trampa"
    />

    <label for="solicitud-nombre">
      {c.nombre}
      <input
        type="text"
        id="solicitud-nombre"
        name="nombre"
        placeholder={c.nombrePh}
        autocomplete="name"
        required
      />
    </label>

    <label for="solicitud-email">
      {c.email}
      <input
        type="email"
        id="solicitud-email"
        name="email"
        placeholder={c.emailPh}
        autocomplete="email"
        required
      />
    </label>

    <label for="solicitud-telefono">
      {c.telefono} <span class="opcional">{c.opcional}</span>
      <input
        type="tel"
        id="solicitud-telefono"
        name="telefono"
        placeholder="+56 9 ..."
        autocomplete="tel"
      />
    </label>

    <label for="solicitud-empresa">
      {c.empresa} <span class="opcional">{c.opcional}</span>
      <input
        type="text"
        id="solicitud-empresa"
        name="empresa"
        placeholder={c.empresaPh}
        autocomplete="organization"
      />
    </label>

    <label for="solicitud-tipo">
      {c.tipo}
      <select id="solicitud-tipo" name="tipo">
        {c.tipos.map((tipo) => <option value={tipo}>{tipo}</option>)}
      </select>
    </label>

    <label for="solicitud-idea">
      {c.idea}
      <textarea id="solicitud-idea" name="idea" rows="4" placeholder={c.ideaPh}></textarea>
    </label>

    <button type="submit" class="boton boton-primario" id="solicitud-enviar">
      {c.enviar} <span aria-hidden="true">↗</span>
    </button>

    <p class="aviso">{t.respuestaPromesa}</p>
  </form>
</dialog>

<style>
  .solicitud {
    width: min(520px, calc(100vw - 32px));
    max-height: min(88vh, 820px);
    padding: clamp(24px, 4vw, 40px);
    border: 1px solid var(--acento-borde-suave);
    border-radius: var(--radio-tarjeta);
    background: var(--panel-destacado);
    color: var(--texto);
    overflow: auto;
  }

  .solicitud::backdrop {
    background: rgba(3, 9, 14, 0.78);
    backdrop-filter: blur(4px);
  }

  .cerrar {
    position: absolute;
    top: clamp(14px, 2vw, 22px);
    right: clamp(14px, 2vw, 22px);
    background: none;
    border: none;
    color: var(--texto-tenue);
    font-size: 26px;
    line-height: 1;
    padding: 0 2px;
    cursor: pointer;
  }

  .cerrar:hover {
    color: var(--acento);
  }

  .rotulo {
    font-family: var(--fuente-titulo);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--acento);
    margin-bottom: 16px;
    padding-right: 32px;
  }

  h2 {
    font-family: var(--fuente-titulo);
    font-size: clamp(26px, 3.4vw, 34px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 14px;
  }

  .bajada {
    font-size: 15px;
    line-height: 1.6;
    color: var(--texto-apagado);
    margin: 0 0 28px;
  }

  .error {
    border: 1px solid rgba(255, 138, 122, 0.5);
    background: rgba(255, 138, 122, 0.08);
    padding: 14px 16px;
    margin-bottom: 20px;
  }

  .error p {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--texto-suave);
  }

  .exito {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 4px 0 8px;
  }

  .exito-marca {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--acento);
    color: var(--bg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
  }

  .exito h3 {
    font-family: var(--fuente-titulo);
    font-size: 21px;
    font-weight: 600;
    margin: 0;
  }

  .exito p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--texto-apagado);
    margin: 0;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  label {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--texto);
  }

  .opcional {
    font-weight: 400;
    color: var(--texto-debil);
  }

  input,
  select,
  textarea {
    width: 100%;
    padding: 13px 14px;
    background: var(--bg);
    border: 1px solid var(--linea-media);
    border-radius: var(--radio);
    color: var(--texto);
    font-family: var(--fuente-texto);
    font-size: 15px;
    font-weight: 400;
  }

  textarea {
    resize: vertical;
    min-height: 96px;
  }

  input::placeholder,
  textarea::placeholder {
    color: var(--texto-debil);
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--acento);
  }

  :is(input, textarea)[aria-invalid='true'] {
    border-color: #ff8a7a;
  }

  /* Honeypot: fuera de la vista pero disponible para los bots. */
  .trampa {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  button[type='submit'] {
    justify-content: center;
    margin-top: 4px;
  }

  button[type='submit']:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .aviso {
    font-size: 12px;
    line-height: 1.7;
    color: var(--texto-debil);
    margin: 0;
  }

</style>

<script>
  import { emailValido, nombreValido, primerError } from '../lib/formulario';

  const dialogo = document.querySelector<HTMLDialogElement>('dialog.solicitud');
  const formulario = document.getElementById('solicitud-form') as HTMLFormElement | null;

  if (dialogo && formulario) {
    const nombre = document.getElementById('solicitud-nombre') as HTMLInputElement | null;
    const email = document.getElementById('solicitud-email') as HTMLInputElement | null;
    const enviar = document.getElementById('solicitud-enviar') as HTMLButtonElement | null;
    const error = document.getElementById('solicitud-error');
    const exito = document.getElementById('solicitud-exito');
    const bajada = document.getElementById('solicitud-bajada');
    const textoBoton = enviar?.innerHTML ?? '';

    const abrir = () => {
      if (dialogo.open) return;
      dialogo.showModal();
      nombre?.focus();
    };

    document.querySelectorAll<HTMLElement>('[data-abrir-solicitud]').forEach((boton) => {
      boton.addEventListener('click', abrir);
    });

    // Llegar desde otra página con /#solicitud abre el formulario directo.
    if (location.hash === '#solicitud') abrir();
    window.addEventListener('hashchange', () => {
      if (location.hash === '#solicitud') abrir();
    });

    const cerrar = () => {
      dialogo.close();
      // Si se llegó por /#solicitud, limpiar el hash para que recargar no lo
      // vuelva a abrir.
      if (location.hash === '#solicitud') {
        history.replaceState(null, '', location.pathname + location.search);
      }
    };

    dialogo.querySelector('[data-cerrar]')?.addEventListener('click', cerrar);
    dialogo.addEventListener('close', () => {
      if (location.hash === '#solicitud') {
        history.replaceState(null, '', location.pathname + location.search);
      }
    });

    // Escape: el <dialog> ya lo hace solo, pero no en todos los contextos.
    dialogo.addEventListener('keydown', (evento) => {
      if (evento.key === 'Escape') {
        evento.preventDefault();
        cerrar();
      }
    });

    // Clic fuera del contenido = cerrar.
    dialogo.addEventListener('click', (evento) => {
      if (evento.target === dialogo) cerrar();
    });

    formulario.addEventListener('submit', async (evento) => {
      evento.preventDefault();
      error?.setAttribute('hidden', '');

      const fallo = primerError([
        {
          el: nombre,
          ok: nombreValido(nombre?.value ?? ''),
          mensaje: dialogo.dataset.errorNombre ?? '',
        },
        {
          el: email,
          ok: emailValido(email?.value ?? ''),
          mensaje: dialogo.dataset.errorEmail ?? '',
        },
      ]);
      if (fallo) {
        fallo.el?.focus();
        fallo.el?.reportValidity?.();
        return;
      }

      if (enviar) {
        enviar.disabled = true;
        enviar.textContent = dialogo.dataset.enviando ?? '…';
      }

      try {
        const respuesta = await fetch(formulario.action, {
          method: 'POST',
          body: new FormData(formulario),
          headers: { Accept: 'application/json' },
        });

        if (respuesta.ok) {
          formulario.hidden = true;
          bajada?.setAttribute('hidden', '');
          exito?.removeAttribute('hidden');
          window.track?.('solicitud_enviada', { label: 'formspree' });
        } else {
          error?.removeAttribute('hidden');
          window.track?.('solicitud_error', { label: String(respuesta.status) });
        }
      } catch {
        error?.removeAttribute('hidden');
        window.track?.('solicitud_error', { label: 'red' });
      } finally {
        if (enviar) {
          enviar.disabled = false;
          enviar.innerHTML = textoBoton;
        }
      }
    });
  }
</script>
