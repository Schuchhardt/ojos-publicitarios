---
// Bloque final del diseño: el proceso ("De tu idea a tu próxima web") y la caja
// de contacto, sobre el mismo fondo oscuro.
import { Image } from 'astro:assets';
import ojo from '../assets/web/ojo.png';
import Redes from './Redes.astro';
import { HOME, type Idioma } from '../data/home';
import { CONTACTO_EMAIL, TIENE_EMAIL, TIENE_WHATSAPP, whatsappUrl } from '../lib/config';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = HOME[idioma];
const p = t.proceso;
const c = t.contacto;
---

<section class="cierre">
  <div class="contenedor">
    <div id="proceso" class="encabezado-proceso" data-reveal-grupo="90">
      <div class="marca">
        <Image src={ojo} alt="" width={110} densities={[1, 2]} loading="lazy" class="ojo" />
        <h2>{p.titulo.normal} <span>{p.titulo.acento}</span></h2>
      </div>
      <p>{p.bajada}</p>
    </div>

    <ol class="pasos" data-reveal-grupo="100">
      {
        p.pasos.map((paso) => (
          <li>
            <div class="rotulo-paso">{paso.rotulo}</div>
            <h3>{paso.titulo}</h3>
            <p>{paso.descripcion}</p>
          </li>
        ))
      }
    </ol>

    <div id="contacto" class="caja" data-reveal>
      <div>
        <div class="rotulo">{c.rotulo}</div>
        <h2 class="titulo-caja">{c.titulo} <span>{c.tituloAcento}</span></h2>
        <p>{c.texto}</p>
      </div>

      <div class="acciones">
        <button type="button" class="accion principal" data-abrir-solicitud data-track="cta_contacto">
          {c.cta} <span aria-hidden="true">↗</span>
        </button>

        {
          TIENE_WHATSAPP && (
            <a
              href={whatsappUrl(t.whatsappMensaje)}
              target="_blank"
              rel="noopener"
              class="accion secundaria"
              data-track="cta_whatsapp"
            >
              {c.whatsapp} <span aria-hidden="true">↗</span>
            </a>
          )
        }

        <div class="nota">
          {t.respuestaPromesa}
          {
            TIENE_EMAIL && (
              <>
                <br />
                <a href={`mailto:${CONTACTO_EMAIL}`} data-track="correo">
                  {CONTACTO_EMAIL}
                </a>
              </>
            )
          }
        </div>

        <Redes />
      </div>
    </div>
  </div>
</section>

<style>
  .cierre {
    padding: var(--pad-y) var(--pad-x);
    background:
      radial-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px) 0 0 / 4px 4px,
      var(--bg-alt);
    color: var(--texto);
  }

  .encabezado-proceso {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px 48px;
    margin-bottom: clamp(32px, 4vw, 48px);
    scroll-margin-top: 100px;
  }

  .marca {
    display: flex;
    align-items: center;
    gap: clamp(16px, 2vw, 28px);
  }

  /* El contorno negro del ojo se pierde sobre el fondo: un halo claro lo
     recupera, como en el diseño. */
  .ojo {
    width: clamp(72px, 8vw, 110px);
    height: auto;
    flex: none;
    filter: drop-shadow(0 0 1px #fff) drop-shadow(0 0 1px #fff) drop-shadow(0 0 0.5px #fff);
  }

  h2 {
    font-family: var(--fuente-titulo);
    font-size: clamp(26px, 3vw, 40px);
    font-weight: 500;
    line-height: 1.12;
    text-transform: uppercase;
    margin: 0;
  }

  h2 span {
    display: block;
    color: var(--acento);
    font-weight: 700;
  }

  .encabezado-proceso > p {
    font-size: 15px;
    line-height: 1.65;
    color: var(--texto-medio);
    margin: 0;
    max-width: 36ch;
  }

  .pasos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
    gap: clamp(20px, 2.6vw, 36px);
    list-style: none;
    padding: 0;
    margin: 0 0 clamp(48px, 6vw, 80px);
  }

  .pasos li {
    padding-top: 24px;
    border-top: 1px solid var(--linea-fuerte);
  }

  .rotulo-paso {
    font-family: var(--fuente-titulo);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--acento);
    margin-bottom: 16px;
  }

  h3 {
    font-family: var(--fuente-texto);
    font-size: 19px;
    font-weight: 700;
    margin: 0 0 10px;
  }

  .pasos p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--texto-apagado);
    margin: 0;
  }

  .caja {
    background: linear-gradient(135deg, #12303a 0%, #0f252c 60%, #0d1f25 100%);
    border-radius: var(--radio-tarjeta);
    padding: clamp(28px, 4vw, 64px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: clamp(24px, 3vw, 56px);
    align-items: center;
    scroll-margin-top: 100px;
  }

  .titulo-caja {
    font-family: var(--fuente-texto);
    font-size: clamp(30px, 3.4vw, 48px);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.03em;
    text-transform: none;
    margin: 0 0 20px;
    text-wrap: balance;
  }

  .titulo-caja span {
    display: inline;
    font-weight: 500;
  }

  .caja p {
    font-size: 15px;
    line-height: 1.65;
    color: var(--texto-medio);
    margin: 0;
    max-width: 48ch;
  }

  .acciones {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 420px;
    width: 100%;
    justify-self: center;
  }

  .accion {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 22px 26px;
    border-radius: var(--radio);
    font-size: 17px;
    font-family: inherit;
    border: 1px solid transparent;
    cursor: pointer;
    text-align: left;
    transition:
      background 0.15s ease,
      border-color 0.15s ease;
  }

  .principal {
    background: var(--acento);
    color: var(--bg-alt);
    font-weight: 700;
  }

  .principal:hover {
    background: var(--acento-claro);
    color: var(--bg-alt);
  }

  .secundaria {
    border-color: var(--linea-boton);
    color: var(--texto);
    font-weight: 600;
    font-size: 15px;
    padding: 16px 26px;
  }

  .secundaria span {
    color: var(--acento);
  }

  .secundaria:hover {
    border-color: var(--acento);
    background: var(--acento-fondo);
    color: var(--texto);
  }

  .nota {
    font-size: 12px;
    color: var(--texto-tenue);
    line-height: 1.7;
    margin-top: 4px;
  }

  .acciones :global(.redes) {
    margin-top: 8px;
  }
</style>
