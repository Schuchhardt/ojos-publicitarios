---
import { REDES } from '../lib/config';

// Íconos de simpleicons.org (CC0) servidos desde el propio sitio: sin pedirle
// nada a un CDN externo en cada visita.
const iconos = import.meta.glob<string>('../assets/redes/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const redes = REDES.map((red) => ({
  ...red,
  svg: iconos[`../assets/redes/${red.icono}.svg`],
})).filter((red) => red.svg);
---

{
  redes.length > 0 && (
    <div class="redes">
      {redes.map((red) => (
        <a
          href={red.url}
          target="_blank"
          rel="noopener"
          title={red.nombre}
          aria-label={red.nombre}
          data-track="red_social"
          data-track-label={red.nombre}
          set:html={red.svg}
        />
      ))}
    </div>
  )
}

<style>
  .redes {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--linea-fuerte);
    border-radius: 50%;
    color: var(--texto-tenue);
    transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease;
  }

  a:hover {
    border-color: var(--acento);
    background: var(--acento-fondo);
    color: var(--acento);
  }

  a :global(svg) {
    width: 16px;
    height: 16px;
    display: block;
  }
</style>
