---
interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** Solo para artículos: fechas ISO y autor. */
  publicado?: Date;
  actualizado?: Date;
  autor?: string;
  lang?: 'es' | 'en';
  /** Ruta de la misma página en cada idioma, para los hreflang. */
  alternos?: Partial<Record<'es' | 'en', string>>;
}

const {
  title,
  description,
  path,
  image = '/og-image.jpg',
  type = 'website',
  noindex = false,
  publicado,
  actualizado,
  autor,
  lang = 'es',
  alternos,
} = Astro.props;

const canonicalURL = new URL(path, Astro.site);
const imageURL = new URL(image, Astro.site);
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content="Ojos Publicitarios" />
<meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_CL'} />
{
  alternos &&
    Object.keys(alternos)
      .filter((codigo) => codigo !== lang)
      .map((codigo) => (
        <meta property="og:locale:alternate" content={codigo === 'en' ? 'en_US' : 'es_CL'} />
      ))
}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={imageURL} />

{
  type === 'article' && (
    <>
      {publicado && <meta property="article:published_time" content={publicado.toISOString()} />}
      {actualizado && <meta property="article:modified_time" content={actualizado.toISOString()} />}
      {autor && <meta property="article:author" content={autor} />}
    </>
  )
}

{
  alternos ? (
    <>
      {alternos.es && <link rel="alternate" hreflang="es" href={new URL(alternos.es, Astro.site)} />}
      {alternos.en && <link rel="alternate" hreflang="en" href={new URL(alternos.en, Astro.site)} />}
      <link rel="alternate" hreflang="x-default" href={new URL(alternos.es ?? path, Astro.site)} />
    </>
  ) : (
    <>
      <link rel="alternate" hreflang="es-cl" href={canonicalURL} />
      <link rel="alternate" hreflang="x-default" href={canonicalURL} />
    </>
  )
}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
