---
import { HOME, type Idioma } from '../data/home';

interface Props {
  idioma: Idioma;
}

const c = HOME[Astro.props.idioma].criterio;
---

<section id="criterio" class="criterio tema-claro">
  <div class="contenedor">
  <div class="intro" data-reveal>
    <div class="rotulo">{c.rotulo}</div>
    <h2 class="titulo-seccion">{c.titulo}</h2>
    <p>{c.texto}</p>
  </div>

  <div class="columnas" data-reveal-grupo="120">
    <div class="columna automatico">
      <div class="titulo">{c.nosEncargamosTitulo}</div>
      <ul>
        {
          c.nosEncargamos.map((item) => (
            <li>
              <span class="marca" aria-hidden="true">
                ✓
              </span>
              {item}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="columna humano">
      <div class="titulo">{c.humanoTitulo}</div>
      <ul>
        {
          c.humano.map((item) => (
            <li>
              <span class="marca" aria-hidden="true">
                —
              </span>
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  </div>
</section>

<style>
  .criterio {
    background: var(--claro-bg);
    padding: var(--pad-y) var(--pad-x);
  }

  .intro {
    max-width: 720px;
    margin-bottom: 48px;
  }

  .titulo-seccion {
    font-size: clamp(26px, 3vw, 42px);
    line-height: 1.12;
    margin-bottom: 20px;
  }

  .intro p {
    font-size: 16px;
    line-height: 1.65;
    color: var(--texto-apagado);
    margin: 0;
    text-wrap: pretty;
  }

  .columnas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: clamp(20px, 3vw, 40px);
  }

  .columna {
    padding: clamp(24px, 2.6vw, 36px);
    border-radius: var(--radio-tarjeta);
  }

  .automatico {
    border: 1px solid rgba(7, 184, 251, 0.45);
    background: #fff;
    box-shadow: 0 18px 40px -32px rgba(7, 184, 251, 0.8);
  }

  .humano {
    border: 1px solid var(--claro-texto);
    background: var(--claro-texto);
    --texto-suave: #d5e3e9;
    --texto-tenue: #9fb3bf;
  }

  .titulo {
    font-family: var(--fuente-titulo);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.14em;
    margin-bottom: 22px;
  }

  .automatico .titulo {
    color: var(--acento);
  }

  .humano .titulo {
    color: var(--texto-tenue);
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  li {
    display: flex;
    gap: 12px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--texto-suave);
  }

  .marca {
    flex: none;
  }

  .automatico .marca {
    color: var(--acento);
  }

  .humano .marca {
    color: var(--texto-tenue);
  }
</style>
