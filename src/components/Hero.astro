---
import { Image } from 'astro:assets';
import foto from '../assets/web/hero.jpg';
import { HOME, type Idioma } from '../data/home';

interface Props {
  idioma: Idioma;
}

const c = HOME[Astro.props.idioma].hero;
---

<section class="hero">
  <Image
    src={foto}
    alt={c.alt}
    widths={[640, 960, 1440, 1907]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="foto"
  />
  <div class="velo" aria-hidden="true"></div>

  <div class="contenido">
    <h1 data-entrada style="--entrada-delay:0ms">
      {c.titulo.map((linea) => <span class="linea">{linea}</span>)}
      <span class="linea acento">{c.tituloAcento}</span>
    </h1>

    <ul class="puntos" data-entrada style="--entrada-delay:120ms">
      {
        c.puntos.map((punto) => (
          <li>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="12" />
              <path d="M7 12.5l3.2 3.2L17 9" />
            </svg>
            {punto}
          </li>
        ))
      }
    </ul>

    <div class="acciones" data-entrada style="--entrada-delay:240ms">
      <a href="#contacto" class="boton boton-oscuro" data-track="cta_hero">
        {c.cta} <span aria-hidden="true">↗</span>
      </a>
      <p class="nota">{c.nota}</p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: clamp(560px, 56vw, 820px);
    padding: clamp(48px, 6vw, 88px) var(--pad-x);
    background: #f3f1ee;
    color: var(--claro-texto);
    overflow: hidden;
    isolation: isolate;
  }

  .foto {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% center;
    z-index: -2;
  }

  :global(.js) .foto {
    animation: acercar 1.6s var(--curva) both;
  }

  @keyframes acercar {
    from {
      transform: scale(1.05);
      opacity: 0.4;
    }
  }

  /* Aclara el lado del texto sin tapar los equipos de la derecha. */
  .velo {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      90deg,
      rgba(246, 245, 242, 0.92) 0%,
      rgba(246, 245, 242, 0.7) 28%,
      rgba(246, 245, 242, 0) 52%
    );
  }

  .contenido {
    width: 100%;
    max-width: var(--ancho-max);
    margin: 0 auto;
  }

  h1 {
    font-family: var(--fuente-titulo);
    font-weight: 700;
    font-size: clamp(38px, 4.2vw, 62px);
    line-height: 1.12;
    letter-spacing: -0.02em;
    margin: 0 0 30px;
  }

  .linea {
    display: block;
  }

  .acento {
    color: var(--celeste);
  }

  .puntos {
    list-style: none;
    padding: 0;
    margin: 0 0 40px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: clamp(17px, 1.5vw, 21px);
    font-weight: 600;
  }

  .puntos li {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .puntos svg {
    width: 26px;
    height: 26px;
    flex: none;
  }

  .puntos circle {
    fill: var(--celeste);
  }

  .puntos path {
    fill: none;
    stroke: #fff;
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .acciones {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }

  .acciones .boton {
    padding: 20px 26px;
    min-width: 290px;
  }

  .nota {
    font-size: 13px;
    font-weight: 600;
    color: var(--claro-texto-suave);
    margin: 0;
  }

  /* En pantallas angostas el texto va arriba y la foto abajo, entera. */
  @media (max-width: 860px) {
    .hero {
      flex-direction: column;
      align-items: stretch;
      min-height: 0;
      padding-bottom: 0;
      background: linear-gradient(180deg, #f6f5f2 0%, #efece8 100%);
    }

    .foto {
      position: relative;
      inset: auto;
      order: 2;
      height: auto;
      aspect-ratio: 4 / 3;
      margin: 36px calc(var(--pad-x) * -1) 0;
      width: calc(100% + var(--pad-x) * 2);
      max-width: none;
      object-position: 72% center;
      z-index: 0;
    }

    .velo {
      display: none;
    }

    .acciones .boton {
      min-width: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .foto {
      animation: none;
    }
  }
</style>
