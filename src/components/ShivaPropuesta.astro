---
import { Image } from 'astro:assets';
import PropuestaLayout from '../layouts/PropuestaLayout.astro';
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/playfair-display/wght-italic.css';
import '@fontsource-variable/readex-pro';
import '@fontsource-variable/jetbrains-mono';
import '../styles/shiva.css';
import {
  FICHAS_NUTRICIONALES,
  LIMITES_ALTO_EN,
  LINEAS,
  PEDIDO_MINIMO,
  PRODUCTOS,
  PROPUESTA,
  RUTAS,
  UNIDADES_CAJA,
  clp,
  precioMayoristaCaja,
  precioMayoristaUnidad,
  selloAltoEn,
} from '../data/shiva';
import { CONTACTO_EMAIL, TIENE_EMAIL, whatsappUrl } from '../lib/config';
import logoBlanco from '../assets/shiva/shiva-logo-blanco.png';
import cajaPedido from '../assets/shiva/fotos/caja-pedido.jpg';
import logoOjos from '../assets/logo-ojos-publicitarios.png';

const p = PROPUESTA;

// Un ejemplo por línea para mostrar cómo queda el precio en cada canal.
const ejemplos = LINEAS.map((linea) => {
  const muestra = PRODUCTOS.find((producto) => producto.linea === linea.id)!;
  return {
    linea: linea.nombre,
    publico: muestra.precio,
    unidad: precioMayoristaUnidad(muestra.precio),
    caja: precioMayoristaCaja(muestra.precio),
  };
});

const fichas = FICHAS_NUTRICIONALES.map((ficha) => ({ ...ficha, ...selloAltoEn(ficha) }));
// Calorías y sodio en enteros; azúcares y grasas con un decimal, como en una tabla nutricional.
const formatoValor = (valor: number, decimales = 0) =>
  valor.toLocaleString('es-CL', { maximumFractionDigits: decimales });

const totalUnicos = p.inversion.unicos.reduce((total, item) => total + item.monto, 0);
const totalTrimestre = totalUnicos + p.inversion.mensual.monto * p.inversion.mensual.mesesMinimos;

const mensajeWhatsapp =
  'Hola, revisamos la propuesta de lanzamiento de Shiva en Chile y queremos conversar.';
---

<PropuestaLayout
  title="Propuesta — Shiva llega a Chile | Ojos Publicitarios"
  description="Propuesta de lanzamiento de Shiva en Chile: tienda online shivacocina.cl, canal mayorista y redes @shivacocina.cl."
  cliente="Shiva Chile"
  etiqueta="Propuesta de lanzamiento"
  nota="En ámbar: lo que falta confirmar"
  fondo="#0f0f0e"
>
  <div class="shiva propuesta">
    <!-- Portada ------------------------------------------------------- -->
    <header class="portada shiva-oscuro">
      <div class="portada-barra">
        <Image src={logoBlanco} alt="Shiva" width={124} densities={[1, 2]} loading="eager" />
        <span>Propuesta de Ojos Publicitarios</span>
      </div>
      <div class="portada-grilla">
        <div class="portada-texto">
          <div class="shiva-rotulo">Propuesta · {p.fecha}</div>
          <h1>Shiva<br />llega a <span class="shiva-serif">Chile.</span></h1>
          <p class="shiva-bajada">
            Tienda propia en shivacocina.cl, un canal para que tiendas y distribuidores compren solos, y
            las redes de @shivacocina.cl desde la primera publicación. Todo pensado para un mismo
            lanzamiento.
          </p>
          <div class="botones">
            <a href={RUTAS.tienda} class="shiva-boton shiva-boton-oro">Ver la demo de la tienda ↗</a>
            <a href="#inversion" class="shiva-boton shiva-boton-borde">Ir a la inversión</a>
          </div>
        </div>
        <div class="portada-foto">
          <Image
            src={cajaPedido}
            alt="Caja abierta con paquetes de Shiva listos para despachar"
            widths={[600, 1000]}
            sizes="(max-width: 900px) 100vw, 42vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
      <nav class="indice" aria-label="Contenido de la propuesta">
        {
          p.frentes.map((frente) => (
            <a href="#frentes">
              <span>{frente.numero}</span>
              {frente.titulo}
            </a>
          ))
        }
        <a href="#pendientes"><span>!</span>Antes de vender</a>
      </nav>
    </header>

    <!-- Punto de partida ---------------------------------------------- -->
    <section class="shiva-seccion">
      <div class="shiva-ancho dos-columnas">
        <div>
          <div class="shiva-rotulo">El punto de partida</div>
          <h2 class="shiva-h2">Lo difícil <span class="shiva-serif">ya está hecho.</span></h2>
          <p class="shiva-bajada">
            En Argentina Shiva ya resolvió producto, empaque, fotos y una tienda que vende, con
            suscripción incluida. En Chile parte de cero en lo que no cruza la cordillera: nadie conoce
            la marca, los precios van en pesos chilenos con IVA, el empaque necesita la etiqueta chilena
            y una tienda que compra al por mayor pide factura.
          </p>
        </div>
        <dl class="cifras">
          <div>
            <dt>9</dt>
            <dd>Sabores en tres líneas: crackers, tostaditas y cookies.</dd>
          </div>
          <div>
            <dt>4</dt>
            <dd>Sellos en el pack: sin gluten, apto vegano, Kosher Parve y apto APLV.</dd>
          </div>
          <div>
            <dt>BPM</dt>
            <dd>Fábrica certificada en inocuidad alimentaria por IRAM.</dd>
          </div>
          <div>
            <dt>−10 %</dt>
            <dd>Suscripción que ya funciona: clientes que vuelven a comprar solos.</dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- Localización -------------------------------------------------- -->
    <section class="shiva-seccion shiva-papel">
      <div class="shiva-ancho">
        <div class="encabezado">
          <div>
            <div class="shiva-rotulo">Al cruzar la cordillera</div>
            <h2 class="shiva-h2">Lo que cambia <span class="shiva-serif">en Chile.</span></h2>
          </div>
          <p class="shiva-bajada">
            No es traducir: es que la marca suene de acá. Esto ya está aplicado en la demo de la tienda.
          </p>
        </div>
        <div class="tabla-envoltorio">
          <table class="tabla">
            <thead>
              <tr>
                <th scope="col">En Argentina</th>
                <th scope="col">En Chile</th>
                <th scope="col">Por qué</th>
              </tr>
            </thead>
            <tbody>
              {
                p.localizacion.map((fila) => (
                  <tr>
                    <td class="tachado">{fila.argentina}</td>
                    <td class="destacado">{fila.chile}</td>
                    <td>{fila.nota}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Tres frentes -------------------------------------------------- -->
    <section class="shiva-seccion shiva-oscuro" id="frentes">
      <div class="shiva-ancho">
        <div class="encabezado">
          <div>
            <div class="shiva-rotulo">La propuesta</div>
            <h2 class="shiva-h2">Tres frentes, <span class="shiva-serif">un lanzamiento.</span></h2>
          </div>
          <p class="shiva-bajada">
            La tienda vende, el canal mayorista pone a Shiva en el mesón de otros, y las redes llevan a
            la gente a los dos.
          </p>
        </div>
        <div class="frentes">
          {
            p.frentes.map((frente, i) => (
              <article class="frente">
                <span class="frente-numero">{frente.numero}</span>
                <h3>{frente.titulo}</h3>
                <p class="frente-bajada">{frente.bajada}</p>
                <ul>
                  {frente.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
                {i === 0 && (
                  <a href={RUTAS.tienda} class="frente-enlace">
                    Ver la demo de la tienda ↗
                  </a>
                )}
                {i === 1 && (
                  <a href={`${RUTAS.tienda}#mayoristas`} class="frente-enlace">
                    Ver el canal mayorista en la demo ↗
                  </a>
                )}
                {i === 2 && (
                  <a href={`${RUTAS.tienda}#redes`} class="frente-enlace">
                    Ver @shivacocina.cl en la demo ↗
                  </a>
                )}
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Plataforma ---------------------------------------------------- -->
    <section class="shiva-seccion">
      <div class="shiva-ancho">
        <div class="encabezado">
          <div>
            <div class="shiva-rotulo">Plataforma</div>
            <h2 class="shiva-h2">Tiendanube, <span class="shiva-serif">otra vez.</span></h2>
          </div>
          <p class="shiva-bajada">
            Recomendamos una segunda tienda en Tiendanube Chile, separada de la argentina: otra moneda,
            otro inventario y otra facturación, pero la misma forma de trabajar.
          </p>
        </div>
        <div class="razones">
          {
            p.plataforma.razones.map((razon, i) => (
              <article>
                <span class="razon-numero">0{i + 1}</span>
                <h3>{razon.titulo}</h3>
                <p>{razon.texto}</p>
              </article>
            ))
          }
        </div>
        <div class="notas-plataforma">
          <p><strong>¿Y Shopify?</strong> {p.plataforma.alternativa}</p>
          <p><strong>El límite.</strong> {p.plataforma.limite}</p>
        </div>
      </div>
    </section>

    <!-- Flujo mayorista ----------------------------------------------- -->
    <section class="shiva-seccion shiva-papel">
      <div class="shiva-ancho">
        <div class="encabezado">
          <div>
            <div class="shiva-rotulo">Canal mayorista</div>
            <h2 class="shiva-h2">Así compra <span class="shiva-serif">una tienda.</span></h2>
          </div>
          <p class="shiva-bajada">
            Sin cotizaciones por WhatsApp: la tienda se registra una vez y desde ahí compra sola, con
            precio neto y factura.
          </p>
        </div>
        <ol class="flujo">
          {
            p.flujoMayorista.map((paso, i) => (
              <li>
                <span class="flujo-numero">{i + 1}</span>
                <h3>{paso.titulo}</h3>
                <p>{paso.texto}</p>
              </li>
            ))
          }
        </ol>

        <div class="precios-ejemplo">
          <div class="precios-cabeza">
            <h3>Cómo queda el precio</h3>
            <span class="shiva-pendiente">Precios referenciales, por confirmar con el costo en Chile</span>
          </div>
          <div class="tabla-envoltorio">
            <table class="tabla">
              <thead>
                <tr>
                  <th scope="col">Línea</th>
                  <th scope="col">Público (con IVA)</th>
                  <th scope="col">Mayorista neto c/u</th>
                  <th scope="col">Caja de {UNIDADES_CAJA} (neto)</th>
                </tr>
              </thead>
              <tbody>
                {
                  ejemplos.map((fila) => (
                    <tr>
                      <td class="destacado">{fila.linea}</td>
                      <td>{clp(fila.publico)}</td>
                      <td>{clp(fila.unidad)}</td>
                      <td>{clp(fila.caja)} + IVA</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          <p class="precios-nota">
            La tienda gana un 35 % al vender al precio sugerido. Pedido mínimo de {clp(PEDIDO_MINIMO)} +
            IVA, combinando sabores. Distribuidores y cadenas, por cotización.
          </p>
        </div>
      </div>
    </section>

    <!-- Redes --------------------------------------------------------- -->
    <section class="shiva-seccion shiva-oscuro">
      <div class="shiva-ancho">
        <div class="encabezado">
          <div>
            <div class="shiva-rotulo">Redes · Instagram y TikTok</div>
            <h2 class="shiva-h2 sin-mayusculas">@shivacocina.cl <span class="shiva-serif">desde cero.</span></h2>
          </div>
          <p class="shiva-bajada">
            Una cuenta nueva no se lanza el día que abre la tienda: se calienta un mes antes, para que el
            día uno ya haya gente esperando.
          </p>
        </div>

        <div class="etapas">
          {
            p.etapasRedes.map((etapa) => (
              <article>
                <span class="etapa-tiempo">{etapa.tiempo}</span>
                <h3>{etapa.titulo}</h3>
                <ul>
                  {etapa.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>

        <h3 class="subtitulo">Pilares de contenido</h3>
        <div class="pilares">
          {
            p.pilares.map((pilar) => (
              <article>
                <h4>{pilar.titulo}</h4>
                <p>{pilar.texto}</p>
              </article>
            ))
          }
        </div>
        <p class="tono">
          <span class="shiva-serif">Tono:</span> cercano y directo, en chileno neutro. Sin voseo y sin
          modismos forzados. El público es adulto, de 25 a 45 años: es quien compra y, como se ve más
          abajo, el único al que se le puede hablar.
        </p>
      </div>
    </section>

    <!-- Sellos -------------------------------------------------------- -->
    <section class="shiva-seccion sellos" id="sellos">
      <div class="shiva-ancho">
        <div class="encabezado">
          <div>
            <div class="shiva-rotulo">Ley 20.606 · Etiquetado de alimentos</div>
            <h2 class="shiva-h2">La etiqueta <span class="shiva-serif">cambia el plan.</span></h2>
          </div>
          <p class="shiva-bajada">
            En Chile un alimento sólido lleva un sello negro “ALTO EN” por cada nutriente que pase el
            límite por 100 g. Con la ficha nutricional que Shiva publica, hicimos la cuenta.
          </p>
        </div>

        <div class="fichas">
          {
            fichas.map((ficha) => (
              <article class="ficha">
                <h3>{ficha.producto}</h3>
                <dl>
                  <div>
                    <dt>Calorías</dt>
                    <dd class:list={{ excede: ficha.valores.calorias > LIMITES_ALTO_EN.calorias }}>
                      {formatoValor(ficha.valores.calorias)} kcal
                    </dd>
                  </div>
                  <div>
                    <dt>Sodio</dt>
                    <dd class:list={{ excede: ficha.valores.sodio > LIMITES_ALTO_EN.sodio }}>
                      {formatoValor(ficha.valores.sodio)} mg
                    </dd>
                  </div>
                  <div>
                    <dt>Azúcares</dt>
                    <dd class:list={{ excede: ficha.valores.azucares > LIMITES_ALTO_EN.azucares }}>
                      {formatoValor(ficha.valores.azucares, 1)} g
                    </dd>
                  </div>
                  <div>
                    <dt>Grasas saturadas</dt>
                    <dd
                      class:list={{
                        excede: ficha.valores.grasasSaturadas > LIMITES_ALTO_EN.grasasSaturadas,
                      }}
                    >
                      {formatoValor(ficha.valores.grasasSaturadas, 1)} g
                    </dd>
                  </div>
                </dl>
                <div class="ficha-sellos">
                  {ficha.sellos.map((sello) => (
                    <span class="shiva-sello">
                      Alto en
                      <b>{sello}</b>
                      <small>Ministerio de Salud</small>
                    </span>
                  ))}
                </div>
              </article>
            ))
          }
          <aside class="limites">
            <h3>Límites por 100 g</h3>
            <ul>
              <li><span>Calorías</span><strong>{LIMITES_ALTO_EN.calorias} kcal</strong></li>
              <li><span>Sodio</span><strong>{LIMITES_ALTO_EN.sodio} mg</strong></li>
              <li><span>Azúcares totales</span><strong>{LIMITES_ALTO_EN.azucares} g</strong></li>
              <li><span>Grasas saturadas</span><strong>{LIMITES_ALTO_EN.grasasSaturadas} g</strong></li>
            </ul>
            <p>
              Toda la línea ronda las 410 kcal por 100 g, así que lo más probable es que cada producto
              lleve al menos “ALTO EN CALORÍAS”.
            </p>
          </aside>
        </div>

        <div class="consecuencias">
          <article>
            <h3>El empaque</h3>
            <p>
              Necesita un rótulo chileno con los sellos y los datos del importador. Los octógonos
              argentinos (“EXCESO EN”) no sirven acá.
            </p>
          </article>
          <article>
            <h3>La comunicación</h3>
            <p>
              Un producto “ALTO EN” no se puede publicitar a menores de 14 años ni con regalos o juegos
              para niños. El Combo Recreo, el Memotest y el e-book Cookids quedan fuera del lanzamiento.
            </p>
          </article>
          <article>
            <h3>La tienda</h3>
            <p>
              Cada ficha muestra sus sellos y la tabla nutricional chilena. Mejor ser claros: el público
              de Shiva lee etiquetas.
            </p>
          </article>
        </div>
        <p class="sellos-nota">
          <span class="shiva-pendiente"
            >Cálculo propio con la porción de 30 g publicada. Confirmar con el análisis de laboratorio y
            un asesor regulatorio.</span
          >
        </p>
      </div>
    </section>

    <!-- Pendientes ---------------------------------------------------- -->
    <section class="shiva-seccion shiva-papel" id="pendientes">
      <div class="shiva-ancho">
        <div class="encabezado">
          <div>
            <div class="shiva-rotulo">Antes de vender</div>
            <h2 class="shiva-h2">Lo que resuelve <span class="shiva-serif">Shiva.</span></h2>
          </div>
          <p class="shiva-bajada">
            La tienda puede estar lista en cinco semanas, pero no se vende sin producto nacionalizado en
            Santiago. Esto corre en paralelo y marca la fecha real de lanzamiento.
          </p>
        </div>
        <ol class="pendientes">
          {
            p.pendientes.map((item, i) => (
              <li>
                <div class="pendiente-cabeza">
                  <span class="pendiente-numero">{String(i + 1).padStart(2, '0')}</span>
                  <span class="shiva-pendiente">Por confirmar</span>
                </div>
                <h3>{item.titulo}</h3>
                <p>{item.texto}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- Hoja de ruta -------------------------------------------------- -->
    <section class="shiva-seccion shiva-oscuro">
      <div class="shiva-ancho">
        <div class="encabezado">
          <div>
            <div class="shiva-rotulo">Hoja de ruta</div>
            <h2 class="shiva-h2">Ocho semanas <span class="shiva-serif">al lanzamiento.</span></h2>
          </div>
          <p class="shiva-bajada">
            Contadas desde el kickoff. La semana 8 se mueve si el stock no está en Santiago a tiempo.
          </p>
        </div>
        <ol class="ruta">
          {
            p.hojaDeRuta.map((etapa) => (
              <li>
                <span class="ruta-semanas">{etapa.semanas}</span>
                <h3>{etapa.titulo}</h3>
                <p>{etapa.texto}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- Inversión ----------------------------------------------------- -->
    <section class="shiva-seccion" id="inversion">
      <div class="shiva-ancho">
        <div class="encabezado">
          <div>
            <div class="shiva-rotulo">Inversión</div>
            <h2 class="shiva-h2">Lo que <span class="shiva-serif">cuesta.</span></h2>
          </div>
          <span class="shiva-pendiente">Valores referenciales en CLP + IVA, para conversar</span>
        </div>

        <div class="inversion">
          <div class="inversion-tabla">
            {
              p.inversion.unicos.map((item) => (
                <div class="inversion-fila">
                  <div>
                    <span class="inversion-tipo">Pago único</span>
                    <h3>{item.concepto}</h3>
                    <p>{item.detalle}</p>
                  </div>
                  <strong>{clp(item.monto)}</strong>
                </div>
              ))
            }
            <div class="inversion-fila">
              <div>
                <span class="inversion-tipo">
                  Mensual · mínimo {p.inversion.mensual.mesesMinimos} meses
                </span>
                <h3>{p.inversion.mensual.concepto}</h3>
                <p>{p.inversion.mensual.detalle}</p>
              </div>
              <strong>{clp(p.inversion.mensual.monto)}<small>/mes</small></strong>
            </div>
            <div class="inversion-total">
              <span>
                Primer trimestre (implementación + {p.inversion.mensual.mesesMinimos} meses de redes)
              </span>
              <strong>{clp(totalTrimestre)} + IVA</strong>
            </div>
            <p class="inversion-pago">{p.inversion.pago}</p>
          </div>

          <aside class="terceros">
            <h3>No incluye</h3>
            <ul>
              {p.inversion.terceros.map((item) => <li>{item}</li>)}
            </ul>
          </aside>
        </div>
      </div>
    </section>

    <!-- Medición ------------------------------------------------------ -->
    <section class="shiva-seccion shiva-papel">
      <div class="shiva-ancho">
        <div class="encabezado">
          <div>
            <div class="shiva-rotulo">Medición</div>
            <h2 class="shiva-h2">Qué <span class="shiva-serif">miramos.</span></h2>
          </div>
          <p class="shiva-bajada">
            Un informe al mes con estos números, y las metas se fijan juntos después del primer mes de
            ventas, con datos reales de Chile.
          </p>
        </div>
        <div class="medicion">
          {
            p.medicion.map((bloque) => (
              <article>
                <h3>{bloque.area}</h3>
                <ul>
                  {bloque.metricas.map((m) => (
                    <li>{m}</li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Próximos pasos ------------------------------------------------ -->
    <section class="shiva-seccion shiva-oscuro cierre">
      <div class="shiva-ancho cierre-grilla">
        <div>
          <div class="shiva-rotulo">Próximos pasos</div>
          <h2 class="shiva-h2">¿Partimos?</h2>
          <ol class="pasos">
            {p.pasos.map((paso) => <li>{paso}</li>)}
          </ol>
        </div>
        <div class="cierre-contacto">
          <a href={whatsappUrl(mensajeWhatsapp)} class="shiva-boton shiva-boton-oro" target="_blank" rel="noopener">
            Conversemos por WhatsApp
          </a>
          <a href={RUTAS.tienda} class="shiva-boton shiva-boton-borde">Ver la demo de la tienda</a>
          {TIENE_EMAIL && <a href={`mailto:${CONTACTO_EMAIL}`} class="cierre-correo">{CONTACTO_EMAIL}</a>}
          <div class="firma">
            <Image src={logoOjos} alt="" width={52} densities={[1, 2]} loading="lazy" />
            <span>Una propuesta de<br /><strong>Ojos Publicitarios</strong></span>
          </div>
        </div>
      </div>
    </section>
  </div>
</PropuestaLayout>

<style>
  /* Portada ----------------------------------------------------------- */
  .portada {
    padding: 22px var(--pad-x) 0;
  }

  .portada-barra {
