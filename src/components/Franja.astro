---
// Cinta de formatos bajo el hero: pasa sola, en bucle. La segunda copia existe
// solo para que el bucle no tenga corte; los lectores de pantalla la saltan.
import { HOME, type Idioma } from '../data/home';

interface Props {
  idioma: Idioma;
}

const items = HOME[Astro.props.idioma].franja;
---

<div class="franja">
  <div class="pista">
    {
      [0, 1].map((copia) => (
        <ul aria-hidden={copia === 1 ? 'true' : undefined}>
          {items.map((item) => (
            <li>
              {item}
              <span class="estrella" aria-hidden="true">✳</span>
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>

<style>
  .franja {
    background: var(--claro-franja);
    border-bottom: 1px solid var(--claro-linea);
    color: var(--claro-texto);
    overflow: hidden;
    padding: 26px 0;
    position: relative;
  }

  /* Los bordes se funden con el fondo de la franja. */
  .franja::before,
  .franja::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 8%;
    z-index: 1;
    pointer-events: none;
  }

  .franja::before {
    left: 0;
    background: linear-gradient(90deg, var(--claro-franja), transparent);
  }

  .franja::after {
    right: 0;
    background: linear-gradient(270deg, var(--claro-franja), transparent);
  }

  .pista {
    display: flex;
    width: max-content;
    animation: pasar 38s linear infinite;
  }

  .franja:hover .pista {
    animation-play-state: paused;
  }

  ul {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    display: flex;
    align-items: center;
    gap: clamp(40px, 6vw, 96px);
    padding-right: clamp(40px, 6vw, 96px);
    font-family: var(--fuente-titulo);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .estrella {
    color: var(--celeste);
    font-size: 20px;
    letter-spacing: 0;
  }

  @keyframes pasar {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pista {
      animation: none;
      width: auto;
      justify-content: center;
    }

    .pista ul {
      flex-wrap: wrap;
      justify-content: center;
      row-gap: 12px;
    }

    .pista ul[aria-hidden] {
      display: none;
    }
  }
</style>
