---
import { Image } from 'astro:assets';
import mockup from '../assets/web/forma.jpg';
import { HOME, type Idioma } from '../data/home';

interface Props {
  idioma: Idioma;
}

const c = HOME[Astro.props.idioma].unico;
---

<section class="unico" id="automatizacion">
  <div class="contenedor rejilla-unico">
    <div class="texto" data-reveal>
      <h2 class="titular">{c.titulo.normal} <span>{c.titulo.acento}</span></h2>
      <p>{c.texto}</p>
    </div>

    <div class="imagen" data-reveal style="--reveal-delay:120ms">
      <Image
        src={mockup}
        alt={c.alt}
        widths={[480, 760, 1040]}
        sizes="(max-width: 960px) 100vw, 55vw"
        loading="lazy"
      />
    </div>

    <div class="tarjetas" data-reveal-grupo="60">
      {
        c.items.map((item, i) => (
          <article class="tarjeta">
            <div class="numero">{String(i + 1).padStart(2, '0')}</div>
            <h3>{item.titulo}</h3>
            <p>{item.descripcion}</p>
          </article>
        ))
      }
      <article class="tarjeta oscura">
        <h3>{c.delegar.titulo}</h3>
        <p>{c.delegar.texto}</p>
        <a href="#contacto" data-track="cta_automatizacion">{c.delegar.cta} ↗</a>
      </article>
    </div>
  </div>
</section>

<style>
  .unico {
    background: var(--claro-bg);
    color: var(--claro-texto);
    padding: var(--pad-y) var(--pad-x);
  }

  .rejilla-unico {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    grid-template-areas:
      'tarjetas texto'
      'tarjetas imagen';
    grid-template-rows: auto 1fr;
    column-gap: clamp(32px, 5vw, 80px);
    row-gap: 28px;
  }

  .texto {
    grid-area: texto;
  }

  .texto p {
    font-size: clamp(16px, 1.25vw, 18px);
    font-weight: 500;
    line-height: 1.65;
    color: var(--claro-texto-suave);
    margin: 22px 0 0;
    max-width: 52ch;
  }

  .imagen {
    grid-area: imagen;
    align-self: center;
  }

  .imagen :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .tarjetas {
    grid-area: tarjetas;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(4, auto);
    grid-auto-flow: column;
    align-self: start;
    filter: drop-shadow(0 18px 30px rgba(14, 20, 24, 0.08));
  }

  .tarjeta {
    background: var(--claro-superficie);
    padding: clamp(20px, 2vw, 28px);
    display: flex;
    flex-direction: column;
    gap: 10px;
    border-bottom: 1px solid #ececec;
    border-right: 1px solid #ececec;
    transition:
      transform 0.4s var(--curva),
      box-shadow 0.4s ease;
  }

  .tarjeta:hover {
    position: relative;
    z-index: 1;
    transform: translateY(-3px);
    box-shadow: 0 16px 34px -20px rgba(7, 184, 251, 0.55);
  }

  .numero {
    font-size: 11px;
    font-weight: 700;
    color: var(--acento-oscuro);
  }

  h3 {
    font-family: var(--fuente-titulo);
    font-size: 17px;
    font-weight: 700;
    line-height: 1.25;
    margin: 0;
  }

  .tarjeta p {
    font-size: 14px;
    line-height: 1.6;
    color: var(--claro-texto-suave);
    margin: 0;
  }

  .oscura {
    background: var(--claro-texto);
    color: #fff;
    justify-content: center;
    border-color: var(--claro-texto);
  }

  .oscura p {
    color: #b9c6ce;
  }

  .oscura a {
    font-size: 14px;
    font-weight: 700;
    color: var(--acento);
  }

  .oscura a:hover {
    color: var(--acento-claro);
  }

  @media (max-width: 960px) {
    .rejilla-unico {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'texto' 'imagen' 'tarjetas';
      grid-template-rows: auto;
    }
  }

  @media (max-width: 560px) {
    .tarjetas {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      grid-auto-flow: row;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tarjeta {
      transition: none;
    }

    .tarjeta:hover {
      transform: none;
    }
  }
</style>
