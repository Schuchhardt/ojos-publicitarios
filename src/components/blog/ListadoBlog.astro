---
// Portada del blog de un idioma: /blog/ o /en/blog/.
import { Image } from 'astro:assets';
import OjosLayout from '../../layouts/OjosLayout.astro';
import EncabezadoBlog from '../ojos/EncabezadoBlog';
import { Pie } from '../ojos/secciones';
import { fechaISO, fechaLarga, minutosDeLectura } from '../../lib/fechas';
import { migasJsonLd } from '../../lib/jsonld';
import { MARCA } from '../../lib/config';
import { RUTA_HOME, type Idioma } from '../../data/home';
import { RUTA_BLOG, TEXTOS_BLOG, notasDe, rutaNota } from '../../data/blog';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = TEXTOS_BLOG[idioma];
const notas = await notasDe(idioma);

const migas = migasJsonLd([
  { nombre: t.inicio, url: new URL(RUTA_HOME[idioma], Astro.site).href },
  { nombre: t.blog, url: new URL(RUTA_BLOG[idioma], Astro.site).href },
]);

const listado = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: `${t.blog} ${MARCA}`,
  description: t.listado.descripcion,
  url: new URL(RUTA_BLOG[idioma], Astro.site).href,
  inLanguage: idioma === 'en' ? 'en-US' : 'es',
  blogPost: notas.map((nota) => ({
    '@type': 'BlogPosting',
    headline: nota.data.titulo,
    description: nota.data.descripcion,
    datePublished: nota.data.fecha.toISOString(),
    url: new URL(rutaNota(nota), Astro.site).href,
  })),
};
---

<OjosLayout
  title={t.listado.titulo}
  description={t.listado.descripcion}
  path={RUTA_BLOG[idioma]}
  lang={idioma}
  alternos={RUTA_BLOG}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(migas)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(listado)} />

  <EncabezadoBlog client:load idioma={idioma} alternos={RUTA_BLOG} />
  <main id="top">
    <section class="seccion">
      <nav class="migas" aria-label={t.migasEtiqueta}>
        <a href={RUTA_HOME[idioma]}>{t.inicio}</a> <span aria-hidden="true">/</span>
        <span>{t.blog}</span>
      </nav>

      <div class="rotulo">{t.listado.rotulo}</div>
      <h1>{t.listado.h1[0]}<br /><em>{t.listado.h1[1]}</em></h1>
      <p class="bajada">{t.listado.bajada}</p>

      <div class="lista">
        {
          notas.map((nota) => (
            <article class:list={['nota', { 'con-imagen': nota.data.imagen }]}>
              {nota.data.imagen && (
                <a href={rutaNota(nota)} class="miniatura" tabindex="-1" aria-hidden="true">
                  <Image src={nota.data.imagen} alt="" widths={[320, 640]} sizes="(max-width: 700px) 100vw, 280px" />
                </a>
              )}
              <div class="texto">
                <div class="meta">
                  <time datetime={fechaISO(nota.data.fecha)}>
                    {fechaLarga(nota.data.fecha, idioma)}
                  </time>
                  <span aria-hidden="true">·</span>
                  <span>
                    {minutosDeLectura(nota.body ?? '')} {t.minLectura}
                  </span>
                </div>
                <h2>
                  <a href={rutaNota(nota)}>{nota.data.titulo}</a>
                </h2>
                <p>{nota.data.descripcion}</p>
                <a class="seguir" href={rutaNota(nota)}>
                  {t.listado.leer} <span aria-hidden="true">↗</span>
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </section>
  </main>
  <Pie idioma={idioma} />
</OjosLayout>

<style>
  /* Mismos tokens y tipografía que el landing (styles/ojos.css). */
  .seccion {
    padding: clamp(120px, 18vh, 180px) clamp(16px, 3vw, 44px) clamp(100px, 14vh, 160px);
  }

  .migas,
  .rotulo,
  .meta {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .migas {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    font-size: 11px;
    margin-bottom: 40px;
  }

  .rotulo {
    margin-bottom: 24px;
  }

  h1 {
    font-size: clamp(44px, 7vw, 120px);
    font-weight: 600;
    line-height: 0.92;
    letter-spacing: -0.045em;
    margin: 0 0 32px;
    text-wrap: balance;
  }

  h1 em {
    font-family: 'Instrument Serif', serif;
    font-weight: 400;
    color: var(--accent);
  }

  .bajada {
    font-size: clamp(18px, 1.5vw, 22px);
    line-height: 1.5;
    color: var(--soft);
    margin: 0 0 clamp(56px, 9vh, 96px);
    max-width: 52ch;
    text-wrap: pretty;
  }

  .lista {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--line);
  }

  .nota {
    padding: 40px 0;
    border-bottom: 1px solid var(--line);
    display: grid;
    gap: 24px 48px;
  }

  .nota.con-imagen {
    grid-template-columns: minmax(240px, 380px) minmax(0, 1fr);
  }

  .miniatura {
    display: block;
    overflow: hidden;
    border-radius: 10px;
    background: var(--card);
  }

  .miniatura img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .nota:hover .miniatura img {
    transform: scale(1.04);
  }

  .texto {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 62ch;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 11px;
  }

  .nota h2 {
    font-size: clamp(26px, 2.8vw, 42px);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
    margin: 0;
    text-wrap: balance;
  }

  .nota p {
    font-size: 17px;
    line-height: 1.55;
    color: var(--soft);
    margin: 0;
    text-wrap: pretty;
  }

  .seguir {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-top: 6px;
  }

  @media (max-width: 760px) {
    .nota.con-imagen {
      grid-template-columns: 1fr;
    }
  }
</style>
