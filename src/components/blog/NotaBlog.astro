---
// Página de una nota, en cualquiera de los dos idiomas. La usan
// /blog/[...slug] (español) y /en/blog/[slug] (inglés).
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import Faq from '../Faq.astro';
import { fechaISO, fechaLarga, minutosDeLectura } from '../../lib/fechas';
import { articuloJsonLd, faqJsonLd, migasJsonLd } from '../../lib/jsonld';
import { CONTACTO_EMAIL, MARCA, TIENE_EMAIL, TIENE_WHATSAPP, whatsappUrl } from '../../lib/config';
import { RUTA_HOME } from '../../data/home';
import { RUTA_BLOG, TEXTOS_BLOG, alternosDe, rutaNota, type Nota } from '../../data/blog';

interface Props {
  nota: Nota;
}

const { nota } = Astro.props;
const { idioma } = nota.data;
const t = TEXTOS_BLOG[idioma];
const { Content } = await render(nota);

// El título del artículo ya es largo: sumarle la marca solo hace que Google
// lo corte. La marca se agrega únicamente cuando cabe.
const tituloSeo =
  nota.data.titulo.length > 45 ? nota.data.titulo : `${nota.data.titulo} | ${MARCA}`;

const ruta = rutaNota(nota);
const url = new URL(ruta, Astro.site).href;
const alternos = await alternosDe(nota);

// Open Graph pide una imagen liviana y en un formato que todas las redes leen.
const portadaOg = nota.data.imagen
  ? (await getImage({ src: nota.data.imagen, width: 1200, format: 'jpg' })).src
  : '/og-image.jpg';

const articulo = articuloJsonLd({
  titulo: nota.data.titulo,
  descripcion: nota.data.descripcion,
  url,
  imagen: new URL(portadaOg, Astro.site).href,
  fecha: nota.data.fecha,
  actualizado: nota.data.actualizado,
  autor: nota.data.autor,
  idioma,
  site: Astro.site,
});

const migas = migasJsonLd([
  { nombre: t.inicio, url: new URL(RUTA_HOME[idioma], Astro.site).href },
  { nombre: t.blog, url: new URL(RUTA_BLOG[idioma], Astro.site).href },
  { nombre: nota.data.titulo, url },
]);

const contacto =
  idioma === 'en' && TIENE_EMAIL
    ? { href: `mailto:${CONTACTO_EMAIL}`, externo: false }
    : TIENE_WHATSAPP
      ? { href: whatsappUrl(), externo: true }
      : null;
---

<BaseLayout
  title={tituloSeo}
  description={nota.data.descripcion}
  path={ruta}
  image={portadaOg}
  type="article"
  publicado={nota.data.fecha}
  actualizado={nota.data.actualizado}
  autor={nota.data.autor}
  lang={idioma}
  alternos={alternos}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(articulo)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(migas)} />
  {
    nota.data.faq.length > 0 && (
      <script
        type="application/ld+json"
        slot="head"
        set:html={JSON.stringify(faqJsonLd(nota.data.faq))}
      />
    )
  }

  <Header idioma={idioma} alternativas={alternos} />
  <main>
    <article class="seccion">
      <nav class="migas" aria-label={t.migasEtiqueta}>
        <a href={RUTA_HOME[idioma]}>{t.inicio}</a> <span aria-hidden="true">/</span>
        <a href={RUTA_BLOG[idioma]}>{t.blog}</a> <span aria-hidden="true">/</span>
        <span>{nota.data.titulo}</span>
      </nav>

      <div class="meta">
        <time datetime={fechaISO(nota.data.fecha)}>{fechaLarga(nota.data.fecha, idioma)}</time>
        <span aria-hidden="true">·</span>
        <span>{minutosDeLectura(nota.body ?? '')} {t.minLectura}</span>
        {
          nota.data.tags.map((tag) => (
            <>
              <span aria-hidden="true">·</span>
              <span>{tag}</span>
            </>
          ))
        }
      </div>

      <h1>{nota.data.titulo}</h1>

      {
        nota.data.imagen && (
          <Image
            class="portada"
            src={nota.data.imagen}
            alt={nota.data.imagenAlt ?? ''}
            widths={[480, 820, 1200, 1640]}
            sizes="(max-width: 860px) 100vw, 820px"
            loading="eager"
            fetchpriority="high"
          />
        )
      }

      <!-- Respuesta directa arriba de todo: es lo que cita un buscador con IA. -->
      <aside class="corto">
        <div class="corto-rotulo">{t.enCorto}</div>
        <p>{nota.data.respuestaCorta}</p>
      </aside>

      <div class="prosa">
        <Content />
      </div>

      {
        nota.data.faq.length > 0 && (
          <div class="faq-nota">
            <Faq preguntas={nota.data.faq} titulo={t.faq} />
          </div>
        )
      }

      <aside class="cierre">
        <h2>{t.cierre.titulo}</h2>
        <p>{t.cierre.texto}</p>
        <div class="acciones">
          <a
            href={`${RUTA_HOME[idioma]}#contacto`}
            class="boton boton-primario"
            data-track="cta_blog_cotizar"
          >
            {t.cierre.cotizar} <span aria-hidden="true">↗</span>
          </a>
          {
            contacto && (
              <a
                href={contacto.href}
                target={contacto.externo ? '_blank' : undefined}
                rel={contacto.externo ? 'noopener' : undefined}
                class="boton boton-secundario"
                data-track="cta_blog_contacto"
              >
                {t.cierre.contactar}
              </a>
            )
          }
        </div>
      </aside>

      <a class="volver" href={RUTA_BLOG[idioma]}>{t.volver}</a>
    </article>
  </main>
  <Footer idioma={idioma} />
</BaseLayout>

<style>
  .seccion {
    max-width: 820px;
  }

  .migas {
    font-family: var(--fuente-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--texto-debil);
    margin-bottom: 28px;
    text-transform: uppercase;
    line-height: 2;
  }

  .migas a {
    color: var(--texto-debil);
  }

  .migas a:hover {
    color: var(--acento);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-family: var(--fuente-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--texto-debil);
    text-transform: uppercase;
    margin-bottom: 18px;
  }

  h1 {
    font-family: var(--fuente-titulo);
    font-weight: 600;
    font-size: clamp(30px, 3.8vw, 46px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 32px;
    text-wrap: pretty;
  }

  .portada {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    margin: 0 0 36px;
  }

  .corto {
    border-left: 2px solid var(--acento);
    background: var(--panel);
    padding: 24px 28px;
    margin: 0 0 44px;
  }

  .corto-rotulo {
    font-family: var(--fuente-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--acento);
    margin-bottom: 12px;
  }

  .corto p {
    margin: 0;
    font-size: clamp(16px, 1.4vw, 18px);
    line-height: 1.65;
    color: var(--texto-suave);
    text-wrap: pretty;
  }

  /* Contenido en markdown: los estilos tienen que cruzar el scope. */
  .prosa :global(h2) {
    font-family: var(--fuente-titulo);
    font-size: clamp(22px, 2.4vw, 28px);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.015em;
    margin: 48px 0 16px;
    text-wrap: pretty;
  }

  .prosa :global(h3) {
    font-family: var(--fuente-titulo);
    font-size: 19px;
    font-weight: 600;
    margin: 32px 0 12px;
  }

  .prosa :global(p) {
    font-size: 17px;
    line-height: 1.75;
    color: var(--texto-apagado);
    margin: 0 0 20px;
    text-wrap: pretty;
  }

  .prosa :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin: 12px 0 8px;
  }

  /* El crédito de la foto va en cursiva justo debajo de la imagen. */
  .prosa :global(p:has(> img) + p > em:only-child) {
    font-size: 13px;
    color: var(--texto-debil);
  }

  .prosa :global(ul),
  .prosa :global(ol) {
    margin: 0 0 24px;
    padding-left: 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .prosa :global(li) {
    font-size: 17px;
    line-height: 1.7;
    color: var(--texto-apagado);
  }

  .prosa :global(li)::marker {
    color: var(--acento);
  }

  .prosa :global(strong) {
    color: var(--texto);
    font-weight: 600;
  }

  .prosa :global(a) {
    border-bottom: 1px solid var(--acento-borde);
  }

  .faq-nota {
    margin-top: 56px;
  }

  .cierre {
    margin-top: 56px;
    background: var(--panel-destacado);
    border: 1px solid var(--acento-borde-suave);
    padding: clamp(24px, 3vw, 40px);
  }

  .cierre h2 {
    font-family: var(--fuente-titulo);
    font-size: clamp(21px, 2.2vw, 26px);
    font-weight: 600;
    margin: 0 0 12px;
  }

  .cierre p {
    font-size: 16px;
    line-height: 1.65;
    color: var(--texto-apagado);
    margin: 0 0 24px;
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .volver {
    display: inline-block;
    margin-top: 40px;
    font-family: var(--fuente-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--texto-debil);
  }

  .volver:hover {
    color: var(--acento);
  }
</style>
