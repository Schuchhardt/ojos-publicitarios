---
// Página de una nota, en cualquiera de los dos idiomas. La usan
// /blog/[...slug] (español) y /en/blog/[slug] (inglés).
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import OjosLayout from '../../layouts/OjosLayout.astro';
import EncabezadoBlog from '../ojos/EncabezadoBlog';
import { Pie } from '../ojos/secciones';
import { fechaISO, fechaLarga, minutosDeLectura } from '../../lib/fechas';
import { articuloJsonLd, faqJsonLd, migasJsonLd } from '../../lib/jsonld';
import { CONTACTO_EMAIL, MARCA, TIENE_EMAIL, TIENE_WHATSAPP, whatsappUrl } from '../../lib/config';
import { RUTA_HOME } from '../../data/home';
import { RUTA_BLOG, TEXTOS_BLOG, alternosDe, rutaNota, type Nota } from '../../data/blog';

interface Props {
  nota: Nota;
}

const { nota } = Astro.props;
const { idioma } = nota.data;
const t = TEXTOS_BLOG[idioma];
const { Content } = await render(nota);

// El título del artículo ya es largo: sumarle la marca solo hace que Google
// lo corte. La marca se agrega únicamente cuando cabe.
const tituloSeo =
  nota.data.titulo.length > 45 ? nota.data.titulo : `${nota.data.titulo} | ${MARCA}`;

const ruta = rutaNota(nota);
const url = new URL(ruta, Astro.site).href;
const alternos = await alternosDe(nota);

// Open Graph pide una imagen liviana y en un formato que todas las redes leen.
const portadaOg = nota.data.imagen
  ? (await getImage({ src: nota.data.imagen, width: 1200, format: 'jpg' })).src
  : '/og-image.jpg';

const articulo = articuloJsonLd({
  titulo: nota.data.titulo,
  descripcion: nota.data.descripcion,
  url,
  imagen: new URL(portadaOg, Astro.site).href,
  fecha: nota.data.fecha,
  actualizado: nota.data.actualizado,
  autor: nota.data.autor,
  idioma,
  site: Astro.site,
});

const migas = migasJsonLd([
  { nombre: t.inicio, url: new URL(RUTA_HOME[idioma], Astro.site).href },
  { nombre: t.blog, url: new URL(RUTA_BLOG[idioma], Astro.site).href },
  { nombre: nota.data.titulo, url },
]);

const contacto =
  idioma === 'en' && TIENE_EMAIL
    ? { href: `mailto:${CONTACTO_EMAIL}`, externo: false }
    : TIENE_WHATSAPP
      ? { href: whatsappUrl(), externo: true }
      : null;
---

<OjosLayout
  title={tituloSeo}
  description={nota.data.descripcion}
  path={ruta}
  image={portadaOg}
  type="article"
  publicado={nota.data.fecha}
  actualizado={nota.data.actualizado}
  autor={nota.data.autor}
  lang={idioma}
  alternos={alternos}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(articulo)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(migas)} />
  {
    nota.data.faq.length > 0 && (
      <script
        type="application/ld+json"
        slot="head"
        set:html={JSON.stringify(faqJsonLd(nota.data.faq))}
      />
    )
  }

  <EncabezadoBlog client:load idioma={idioma} alternos={alternos} />
  <main id="top">
    <article class="seccion">
      <nav class="migas" aria-label={t.migasEtiqueta}>
        <a href={RUTA_HOME[idioma]}>{t.inicio}</a> <span aria-hidden="true">/</span>
        <a href={RUTA_BLOG[idioma]}>{t.blog}</a> <span aria-hidden="true">/</span>
        <span>{nota.data.titulo}</span>
      </nav>

      <div class="meta">
        <time datetime={fechaISO(nota.data.fecha)}>{fechaLarga(nota.data.fecha, idioma)}</time>
        <span aria-hidden="true">·</span>
        <span>{minutosDeLectura(nota.body ?? '')} {t.minLectura}</span>
        {
          nota.data.tags.map((tag) => (
            <>
              <span aria-hidden="true">·</span>
              <span>{tag}</span>
            </>
          ))
        }
      </div>

      <h1>{nota.data.titulo}</h1>

      {
        nota.data.imagen && (
          <Image
            class="portada"
            src={nota.data.imagen}
            alt={nota.data.imagenAlt ?? ''}
            widths={[480, 820, 1200, 1640]}
            sizes="(max-width: 860px) 100vw, 820px"
            loading="eager"
            fetchpriority="high"
          />
        )
      }

      <!-- Respuesta directa arriba de todo: es lo que cita un buscador con IA. -->
      <aside class="corto">
        <div class="corto-rotulo">{t.enCorto}</div>
        <p>{nota.data.respuestaCorta}</p>
      </aside>

      <div class="prosa">
        <Content />
      </div>

      {
        nota.data.faq.length > 0 && (
          <section class="faq-nota">
            <h2>{t.faq}</h2>
            {nota.data.faq.map((item, i) => (
              <details name="faq" open={i === 0}>
                <summary data-cursor="">
                  <h3>{item.pregunta}</h3>
                  <span class="mas" aria-hidden="true">add</span>
                </summary>
                <p>{item.respuesta}</p>
              </details>
            ))}
          </section>
        )
      }

      <aside class="cierre">
        <h2>{t.cierre.titulo}</h2>
        <p>{t.cierre.texto}</p>
        <div class="acciones">
          <a
            href={`${RUTA_HOME[idioma]}#contacto`}
            class="boton boton-primario" data-cursor=""
            data-track="cta_blog_cotizar"
          >
            {t.cierre.cotizar} <span aria-hidden="true">↗</span>
          </a>
          {
            contacto && (
              <a
                href={contacto.href}
                target={contacto.externo ? '_blank' : undefined}
                rel={contacto.externo ? 'noopener' : undefined}
                class="boton boton-secundario" data-cursor=""
                data-track="cta_blog_contacto"
              >
                {t.cierre.contactar}
              </a>
            )
          }
        </div>
      </aside>

      <a class="volver" href={RUTA_BLOG[idioma]}>{t.volver}</a>
    </article>
  </main>
  <Pie idioma={idioma} />
</OjosLayout>

<style>
  /* Mismos tokens y tipografía que el landing (styles/ojos.css). */
  .seccion {
    max-width: 860px;
    margin: 0 auto;
    padding: clamp(120px, 18vh, 170px) clamp(16px, 3vw, 44px) clamp(100px, 14vh, 160px);
    box-sizing: content-box;
  }

  .migas,
  .meta,
  .corto-rotulo,
  .volver {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .migas {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    line-height: 1.8;
    margin-bottom: 36px;
  }

  .migas span:last-child {
    color: var(--accent);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
  }

  h1 {
    font-size: clamp(38px, 5.4vw, 76px);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.04em;
    margin: 0 0 40px;
    text-wrap: balance;
  }

  .portada {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 10px;
    background: var(--card);
    margin: 0 0 44px;
  }

  .corto {
    border-left: 2px solid var(--accent);
    background: var(--card);
    border-radius: 0 10px 10px 0;
    padding: 24px 28px;
    margin: 0 0 48px;
  }

  .corto-rotulo {
    color: var(--accent);
    margin-bottom: 12px;
  }

  .corto p {
    margin: 0;
    font-size: clamp(18px, 1.5vw, 21px);
    line-height: 1.5;
    color: var(--ink);
    text-wrap: pretty;
  }

  /* Contenido en markdown: los estilos tienen que cruzar el scope. */
  .prosa :global(h2) {
    font-size: clamp(28px, 3vw, 42px);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
    margin: 64px 0 20px;
    text-wrap: balance;
  }

  .prosa :global(h3) {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.015em;
    margin: 36px 0 12px;
  }

  .prosa :global(p),
  .prosa :global(li) {
    font-size: 18px;
    line-height: 1.65;
    color: var(--soft);
    text-wrap: pretty;
  }

  .prosa :global(p) {
    margin: 0 0 22px;
  }

  .prosa :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 10px;
    margin: 16px 0 8px;
  }

  /* El crédito de la foto va en cursiva justo debajo de la imagen. */
  .prosa :global(p:has(> img) + p > em:only-child) {
    font-family: 'JetBrains Mono', monospace;
    font-style: normal;
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .prosa :global(ul),
  .prosa :global(ol) {
    margin: 0 0 26px;
    padding-left: 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .prosa :global(li)::marker {
    color: var(--accent);
  }

  .prosa :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }

  .prosa :global(a) {
    color: var(--accent);
    border-bottom: 1px solid currentColor;
  }

  .faq-nota {
    margin-top: 80px;
    border-bottom: 1px solid var(--line);
  }

  .faq-nota h2 {
    font-size: clamp(32px, 3.6vw, 56px);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.04em;
    margin: 0 0 32px;
  }

  details {
    border-top: 1px solid var(--line);
  }

  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 24px 0;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary h3 {
    margin: 0;
    font-size: clamp(19px, 1.7vw, 24px);
    font-weight: 500;
    letter-spacing: -0.015em;
  }

  summary:hover h3 {
    color: var(--accent);
  }

  .mas {
    flex: none;
    font-family: 'Material Symbols Outlined';
    font-weight: 300;
    font-size: 30px;
    line-height: 1;
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  details[open] .mas {
    transform: rotate(45deg);
  }

  details p {
    margin: 0;
    padding: 0 0 28px;
    font-size: 17px;
    line-height: 1.55;
    color: var(--soft);
    max-width: 62ch;
  }

  /* Cierre con los colores invertidos, como el bloque de contacto del landing. */
  .cierre {
    margin-top: 80px;
    background: var(--ink);
    color: var(--bg);
    border-radius: 18px;
    padding: clamp(28px, 4vw, 56px);
  }

  .cierre h2 {
    font-size: clamp(30px, 3.4vw, 52px);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.04em;
    margin: 0 0 18px;
    text-wrap: balance;
  }

  .cierre p {
    font-size: 18px;
    line-height: 1.55;
    color: var(--isoft);
    margin: 0 0 32px;
    max-width: 52ch;
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .boton {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 16px 24px;
    border-radius: 999px;
    border: 1px solid var(--bg);
    transition: background 0.25s, color 0.25s;
  }

  .boton-primario {
    background: var(--bg);
    color: var(--ink);
  }

  .boton-primario:hover {
    background: var(--iaccent);
    border-color: var(--iaccent);
    color: var(--ink);
  }

  .boton-secundario {
    color: var(--bg);
  }

  .boton-secundario:hover {
    background: var(--bg);
    color: var(--ink);
  }

  .volver {
    display: inline-block;
    margin-top: 48px;
    font-size: 12px;
  }
</style>
