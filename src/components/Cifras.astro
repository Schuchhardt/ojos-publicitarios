---
import { CIFRAS } from '../data/contenido';
---

<section class="cifras" data-reveal-grupo="70">
  {
    CIFRAS.map((cifra) => (
      <div class="cifra">
        {cifra.pendiente ? (
          <>
            <div class="rotulo-pendiente">{cifra.rotulo}</div>
            <div class="texto pendiente">{cifra.texto}</div>
          </>
        ) : (
          <>
            <div class:list={['valor', { destacada: cifra.destacada }]}>{cifra.valor}</div>
            <div class="texto">{cifra.texto}</div>
          </>
        )}
      </div>
    ))
  }
</section>

<style>
  .cifras {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    border-top: 1px solid var(--linea);
    border-bottom: 1px solid var(--linea);
    background: var(--bg-alt);
  }

  .cifra {
    padding: 28px clamp(16px, 3vw, 40px);
    border-right: 1px solid rgba(255, 255, 255, 0.06);
  }

  .cifra:last-child {
    border-right: none;
  }

  .valor {
    font-family: var(--fuente-titulo);
    font-size: 30px;
    font-weight: 600;
    color: var(--texto);
    margin-bottom: 6px;
  }

  .valor.destacada {
    color: var(--acento);
  }

  .texto {
    font-size: 14px;
    color: var(--texto-apagado);
    line-height: 1.5;
  }

  .texto.pendiente {
    color: var(--texto-debil);
  }

  .rotulo-pendiente {
    font-family: var(--fuente-mono);
    font-size: 11px;
    color: var(--acento);
    letter-spacing: 0.14em;
    margin-bottom: 8px;
  }
</style>
