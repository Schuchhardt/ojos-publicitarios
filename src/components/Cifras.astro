---
import { HOME, type Idioma } from '../data/home';

interface Props {
  idioma: Idioma;
}

const cifras = HOME[Astro.props.idioma].cifras;
---

<section class="cifras tema-claro" data-reveal-grupo="70">
  {
    cifras.map((cifra) => (
      <div class="cifra">
        <div class:list={['valor', { destacada: cifra.destacada }]}>{cifra.valor}</div>
        <div class="texto">{cifra.texto}</div>
      </div>
    ))
  }
</section>

<style>
  .cifras {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    border-top: 1px solid var(--linea);
    border-bottom: 1px solid var(--linea);
    background: #fff;
  }

  .cifra {
    padding: clamp(28px, 3vw, 40px) clamp(16px, 3vw, 40px);
    border-right: 1px solid var(--linea);
  }

  .cifra:last-child {
    border-right: none;
  }

  .valor {
    font-family: var(--fuente-titulo);
    font-size: clamp(30px, 3vw, 40px);
    font-weight: 700;
    color: var(--texto);
    margin-bottom: 6px;
  }

  .valor.destacada {
    color: var(--celeste);
  }

  .texto {
    font-size: 14px;
    color: var(--texto-apagado);
    line-height: 1.5;
  }

</style>
