---
import Logo from './Logo.astro';
import Redes from './Redes.astro';
import { HOME, type Idioma } from '../data/home';
import { ANIO, MARCA } from '../lib/config';

interface Props {
  idioma?: Idioma;
}

const { idioma = 'es' } = Astro.props;
---

<footer class="tema-claro">
  <Logo variante="footer" />
  <div class="centro">
    <Redes />
    <div class="tagline">{HOME[idioma].tagline}</div>
  </div>
  <div class="copyright">© {ANIO} {MARCA}</div>
</footer>

<style>
  footer {
    padding: 28px var(--pad-x);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-around;
    gap: 20px 40px;
  }

  .centro {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .tagline,
  .copyright {
    font-size: 12px;
    color: var(--claro-texto-suave);
  }

  @media (max-width: 700px) {
    footer {
      flex-direction: column;
      text-align: center;
    }

    .centro {
      flex-direction: column;
    }
  }
</style>
