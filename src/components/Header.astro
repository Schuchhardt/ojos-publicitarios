---
import Logo from './Logo.astro';
import { HOME, IDIOMAS, RUTA_HOME, type Idioma } from '../data/home';

interface Props {
  idioma?: Idioma;
  /**
   * Adónde lleva cada botón de idioma. Por defecto, la home de ese idioma: el
   * blog está solo en español, así que desde ahí "EN" lleva a /en/.
   */
  alternativas?: Partial<Record<Idioma, string>>;
}

const { idioma = 'es', alternativas = {} } = Astro.props;
const c = HOME[idioma];
const home = RUTA_HOME[idioma];

// Los anclas llevan la ruta de la home delante: desde el blog también sirven.
const nav = c.nav.map((item) => ({
  ...item,
  href: item.href.startsWith('#') ? `${home}${item.href}` : item.href,
}));

const idiomas = IDIOMAS.map((codigo) => ({
  codigo,
  href: codigo === idioma ? home : (alternativas[codigo] ?? RUTA_HOME[codigo]),
}));
---

<header class="header" id="inicio">
  <a href={home} class="marca" aria-label="Ojos Publicitarios">
    <Logo variante="header" bajada={c.marcaBajada} />
  </a>

  <nav class="nav" aria-label={c.menu.abrir}>
    {nav.map((item) => <a href={item.href}>{item.texto}</a>)}
  </nav>

  <div class="acciones">
    <div class="idiomas" role="group" aria-label={c.idiomaEtiqueta}>
      {
        idiomas.map((item) => (
          <a
            href={item.href}
            hreflang={item.codigo}
            lang={item.codigo}
            data-idioma={item.codigo}
            aria-current={item.codigo === idioma ? 'true' : undefined}
            class:list={['idioma', { activo: item.codigo === idioma }]}
          >
            {item.codigo.toUpperCase()}
          </a>
        ))
      }
    </div>

    <a href={`${home}#contacto`} class="cta" data-track="cta_header">
      {c.headerCta} <span aria-hidden="true">↗</span>
    </a>

    <button
      type="button"
      class="menu"
      aria-label={c.menu.abrir}
      aria-expanded="false"
      aria-controls="menu-movil"
      data-abrir={c.menu.abrir}
      data-cerrar={c.menu.cerrar}
    >
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>
  </div>

  <nav class="menu-movil" id="menu-movil" aria-label={c.menu.abrir} hidden>
    {nav.map((item) => <a href={item.href}>{item.texto}</a>)}
  </nav>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 18px var(--pad-x);
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid transparent;
    color: var(--claro-texto);
    transition:
      border-color 0.4s ease,
      box-shadow 0.4s ease,
      padding 0.4s var(--curva);
  }

  /* Al bajar, la cabecera se compacta y aparece su sombra. */
  .header[data-scrolled] {
    padding-top: 11px;
    padding-bottom: 11px;
    border-bottom-color: var(--claro-linea);
    box-shadow: 0 10px 30px -24px rgba(14, 20, 24, 0.45);
  }

  .marca {
    flex: none;
    color: inherit;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(14px, 2.4vw, 36px);
    font-size: 14px;
    font-weight: 600;
  }

  .nav a {
    position: relative;
    padding-bottom: 3px;
    color: var(--claro-texto);
  }

  /* Subrayado que crece desde el centro. */
  .nav a::after {
    content: '';
    position: absolute;
    left: 50%;
    right: 50%;
    bottom: 0;
    height: 2px;
    background: var(--celeste);
    transition:
      left 0.35s var(--curva),
      right 0.35s var(--curva);
  }

  .nav a:hover,
  .nav a[data-activo] {
    color: var(--acento-oscuro);
  }

  .nav a:hover::after,
  .nav a[data-activo]::after {
    left: 0;
    right: 0;
  }

  .acciones {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: none;
  }

  .idiomas {
    display: flex;
    border: 1px solid var(--claro-linea);
    border-radius: 999px;
    padding: 3px;
  }

  .idioma {
    font-family: var(--fuente-titulo);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 5px 9px;
    border-radius: 999px;
    color: var(--claro-texto-suave);
  }

  .idioma:hover {
    color: var(--claro-texto);
  }

  .idioma.activo {
    background: var(--claro-texto);
    color: #fff;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 22px;
    padding: 12px 20px;
    border-radius: var(--radio);
    background: var(--claro-texto);
    color: #fff;
    font-weight: 700;
    font-size: 14px;
    transition:
      background 0.3s ease,
      transform 0.3s var(--curva);
  }

  .cta:hover {
    background: #26323a;
    color: #fff;
    transform: translateY(-1px);
  }

  /* Botón de menú: solo aparece cuando la navegación no cabe */
  .menu {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: 0;
    background: none;
    border: 1px solid var(--claro-linea);
    border-radius: var(--radio);
    cursor: pointer;
  }

  .menu span {
    display: block;
    width: 16px;
    height: 1.5px;
    margin: 0 auto;
    background: var(--claro-texto);
    transition:
      transform 0.18s ease,
      opacity 0.18s ease;
  }

  .menu-movil {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    flex-direction: column;
    padding: 8px var(--pad-x) 20px;
    background: #fff;
    border-bottom: 1px solid var(--claro-linea);
    box-shadow: 0 24px 40px -30px rgba(14, 20, 24, 0.5);
  }

  .menu-movil a {
    padding: 14px 0;
    font-size: 15px;
    font-weight: 600;
    color: var(--claro-texto);
    border-bottom: 1px solid var(--claro-linea);
  }

  @media (max-width: 1080px) {
    .nav {
      display: none;
    }

    .menu {
      display: flex;
    }

    .menu-movil:not([hidden]) {
      display: flex;
    }

    .header[data-abierto] .menu span:first-child {
      transform: translateY(3.25px) rotate(45deg);
    }

    .header[data-abierto] .menu span:last-child {
      transform: translateY(-3.25px) rotate(-45deg);
    }
  }

  @media (max-width: 600px) {
    .header {
      gap: 12px;
    }

    .cta {
      display: none;
    }

    .acciones {
      gap: 8px;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.header');
  const boton = header?.querySelector<HTMLButtonElement>('.menu');
  const menu = header?.querySelector<HTMLElement>('.menu-movil');

  if (header && boton && menu) {
    const cerrar = () => {
      header.removeAttribute('data-abierto');
      menu.hidden = true;
      boton.setAttribute('aria-expanded', 'false');
      boton.setAttribute('aria-label', boton.dataset.abrir ?? '');
    };

    boton.addEventListener('click', () => {
      const abierto = header.hasAttribute('data-abierto');
      if (abierto) {
        cerrar();
      } else {
        header.setAttribute('data-abierto', '');
        menu.hidden = false;
        boton.setAttribute('aria-expanded', 'true');
        boton.setAttribute('aria-label', boton.dataset.cerrar ?? '');
      }
    });

    menu.addEventListener('click', (evento) => {
      if (evento.target instanceof HTMLAnchorElement) cerrar();
    });

    document.addEventListener('keydown', (evento) => {
      if (evento.key === 'Escape') cerrar();
    });
  }

  // Elegir idioma a mano gana sobre la detección automática del navegador.
  document.querySelectorAll<HTMLAnchorElement>('[data-idioma]').forEach((enlace) => {
    enlace.addEventListener('click', () => {
      try {
        localStorage.setItem('op-idioma', enlace.dataset.idioma ?? '');
      } catch {
        // Sin almacenamiento (modo privado): la elección vale solo para este clic.
      }
    });
  });
</script>
