---
import Logo from './Logo.astro';
import { NAV } from '../lib/config';
---

<header class="header" id="inicio">
  <a href="/" class="marca" aria-label="Ojos Publicitarios — inicio">
    <Logo variante="header" />
  </a>

  <nav class="nav" aria-label="Secciones del sitio">
    {NAV.map((item) => <a href={item.href}>{item.texto}</a>)}
  </nav>

  <div class="acciones">
    <a href="/#contacto" class="cta" data-track="cta_header">Hablemos <span aria-hidden="true">↗</span></a>
    <button
      type="button"
      class="menu"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="menu-movil"
    >
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>
  </div>

  <nav class="menu-movil" id="menu-movil" aria-label="Secciones del sitio" hidden>
    {NAV.map((item) => <a href={item.href}>{item.texto}</a>)}
  </nav>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 16px var(--pad-x);
    background: rgba(6, 17, 26, 0.88);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--linea);
  }

  .marca {
    flex: none;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(14px, 2.4vw, 32px);
    font-size: 14px;
  }

  .nav a {
    color: var(--texto-medio);
  }

  .nav a:hover {
    color: var(--acento);
  }

  .acciones {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: none;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 20px;
    border-radius: var(--radio);
    background: var(--acento);
    color: var(--bg);
    font-weight: 600;
    font-size: 14px;
  }

  .cta:hover {
    background: var(--acento-claro);
    color: var(--bg);
  }

  /* Botón de menú: solo aparece cuando la navegación no cabe */
  .menu {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: 0;
    background: none;
    border: 1px solid var(--linea-fuerte);
    border-radius: var(--radio);
    cursor: pointer;
  }

  .menu span {
    display: block;
    width: 16px;
    height: 1.5px;
    margin: 0 auto;
    background: var(--texto);
    transition: transform 0.18s ease, opacity 0.18s ease;
  }

  .menu-movil {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    flex-direction: column;
    padding: 8px var(--pad-x) 20px;
    background: var(--bg);
    border-bottom: 1px solid var(--linea);
  }

  .menu-movil a {
    padding: 14px 0;
    font-size: 15px;
    color: var(--texto-medio);
    border-bottom: 1px solid var(--linea);
  }

  @media (max-width: 900px) {
    .nav {
      display: none;
    }

    .menu {
      display: flex;
    }

    .menu-movil:not([hidden]) {
      display: flex;
    }

    .header[data-abierto] .menu span:first-child {
      transform: translateY(3.25px) rotate(45deg);
    }

    .header[data-abierto] .menu span:last-child {
      transform: translateY(-3.25px) rotate(-45deg);
    }
  }

  @media (max-width: 520px) {
    .cta {
      padding: 11px 14px;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.header');
  const boton = header?.querySelector<HTMLButtonElement>('.menu');
  const menu = header?.querySelector<HTMLElement>('.menu-movil');

  if (header && boton && menu) {
    const cerrar = () => {
      header.removeAttribute('data-abierto');
      menu.hidden = true;
      boton.setAttribute('aria-expanded', 'false');
      boton.setAttribute('aria-label', 'Abrir menú');
    };

    boton.addEventListener('click', () => {
      const abierto = header.hasAttribute('data-abierto');
      if (abierto) {
        cerrar();
      } else {
        header.setAttribute('data-abierto', '');
        menu.hidden = false;
        boton.setAttribute('aria-expanded', 'true');
        boton.setAttribute('aria-label', 'Cerrar menú');
      }
    });

    menu.addEventListener('click', (evento) => {
      if (evento.target instanceof HTMLAnchorElement) cerrar();
    });

    document.addEventListener('keydown', (evento) => {
      if (evento.key === 'Escape') cerrar();
    });
  }
</script>
