---
import { Image } from 'astro:assets';
import PropuestaLayout from '../layouts/PropuestaLayout.astro';
// Serif con eje óptico para los titulares: a 70 px se lee como una marca con
// años encima, no como una landing más.
import '@fontsource-variable/fraunces/opsz.css';
import { CONTENIDO, IDIOMAS, type Idioma } from '../data/ludrimar';
import { cargarImagen } from '../lib/imagenes';
// Lockup horizontal armado con la gráfica del propio logo: en una barra fija,
// la versión apilada obliga a una cabecera de 110 px.
import lockupBlanco from '../assets/ludrimar/ludrimar-lockup-blanco.png';
import lockupColor from '../assets/ludrimar/ludrimar-lockup.png';
import marcaBlanca from '../assets/ludrimar/ludrimar-marca-blanco.png';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const c = CONTENIDO[idioma];

const cortes = await Promise.all(
  c.producto.cortes.map(async (corte) => ({ ...corte, foto: await cargarImagen(corte.imagen) }))
);
const planta = await cargarImagen('ludrimar/productos/planta.jpg');
---

<PropuestaLayout
  title={`Propuesta — Pesquera Ludrimar Ltda | Ojos Publicitarios`}
  description={c.meta.descripcion}
  cliente="Pesquera Ludrimar Ltda"
  nota="Demo navegable · contenido y fotos de referencia"
  lang={idioma}
>
  <div class="ludrimar">
    <!-- Cabecera ------------------------------------------------------ -->
    <header class="cabecera">
      <a href="#top" class="marca" aria-label="Pesquera Ludrimar Ltda">
        <Image src={lockupBlanco} alt="" width={178} height={42} densities={[1, 2]} loading="eager" />
      </a>
      <nav class="nav" aria-label="Sections">
        {c.nav.map((item) => <a href={item.href}>{item.texto}</a>)}
      </nav>
      <div class="acciones">
        <div class="idiomas" role="group" aria-label="Language">
          {
            IDIOMAS.map((item) => (
              <a
                href={item.ruta}
                class:list={['idioma', { activo: item.codigo === idioma }]}
                hreflang={item.codigo}
                aria-current={item.codigo === idioma ? 'true' : undefined}
              >
                {item.etiqueta}
              </a>
            ))
          }
        </div>
        <a href="#contact" class="lud-boton lud-boton-primario cta-cabecera">{c.cta}</a>
      </div>
    </header>

    <!-- Portada ------------------------------------------------------- -->
    <section class="portada" id="top">
      <Image src={marcaBlanca} alt="" class="marca-agua" width={720} densities={[1, 2]} />
      <div class="portada-texto">
        <div class="lud-rotulo">{c.hero.epigrafe}</div>
        <h1>
          {
            c.hero.titulo.map((linea, i) => (
              <>
                {i > 0 && <br />}
                {linea}
              </>
            ))
          }
        </h1>
        <p class="lud-bajada">{c.hero.bajada}</p>
        <div class="portada-botones">
          <a href="#contact" class="lud-boton lud-boton-primario">
            {c.hero.ctaPrimario} <span aria-hidden="true">↗</span>
          </a>
          <a href="#specs" class="lud-boton lud-boton-secundario">{c.hero.ctaSecundario}</a>
        </div>
        <div class="portada-pie">{c.hero.pie}</div>
      </div>
    </section>

    <!-- Cifras -------------------------------------------------------- -->
    <section class="cifras">
      {
        c.cifras.map((cifra) => (
          <div class="cifra">
            <div class="cifra-valor">{cifra.valor}</div>
            <div class="cifra-texto">{cifra.texto}</div>
          </div>
        ))
      }
    </section>

    <!-- Producto ------------------------------------------------------ -->
    <section class="lud-seccion" id="squid">
      <div class="lud-ancho">
        <div class="encabezado">
          <div>
            <div class="lud-rotulo">{c.producto.rotulo}</div>
            <h2 class="lud-h2">{c.producto.titulo}</h2>
          </div>
          <p class="lud-bajada">{c.producto.bajada}</p>
        </div>

        <div class="cortes">
          {
            cortes.map((corte) => (
              <article class="corte">
                {corte.foto && (
                  <Image
                    src={corte.foto}
                    alt={corte.nombre}
                    widths={[400, 700, 1168]}
                    sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 33vw"
                    loading="lazy"
                    class="corte-foto"
                  />
                )}
                <div class="corte-texto">
                  <h3>{corte.nombre}</h3>
                  <div class="corte-bajada">{corte.bajada}</div>
                  <p>{corte.texto}</p>
                </div>
              </article>
            ))
          }
        </div>

      </div>
    </section>

    <!-- Ficha técnica -------------------------------------------------- -->
    <section class="lud-seccion lud-hielo" id="specs">
      <div class="lud-ancho especificaciones">
        <div>
          <div class="lud-rotulo">{c.specs.rotulo}</div>
          <h2 class="lud-h2">{c.specs.titulo}</h2>
          <p class="lud-bajada">{c.specs.bajada}</p>
          <a href="#contact" class="lud-boton lud-boton-azul ficha-cta">
            {c.specs.cta} <span aria-hidden="true">↗</span>
          </a>
        </div>

        <dl class="tabla">
          {
            c.specs.filas.map((fila) => (
              <div class="fila">
                <dt>{fila.campo}</dt>
                <dd>{fila.valor}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- Calidad ------------------------------------------------------- -->
    <section class="lud-seccion lud-oscuro" id="quality">
      <div class="lud-ancho">
        <div class="encabezado">
          <div>
            <div class="lud-rotulo">{c.calidad.rotulo}</div>
            <h2 class="lud-h2">{c.calidad.titulo}</h2>
          </div>
          <p class="lud-bajada">{c.calidad.bajada}</p>
        </div>

        <div class="calidad">
          {
            c.calidad.bloques.map((bloque) => (
              <article>
                <h3>{bloque.titulo}</h3>
                <p>{bloque.texto}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Proceso ------------------------------------------------------- -->
    <section class="lud-seccion" id="process">
      <div class="lud-ancho">
        <div class="encabezado">
          <div>
            <div class="lud-rotulo">{c.proceso.rotulo}</div>
            <h2 class="lud-h2">{c.proceso.titulo}</h2>
          </div>
          <p class="lud-bajada">{c.proceso.bajada}</p>
        </div>

        <div class="proceso">
          {
            c.proceso.etapas.map((etapa) => (
              <div class="etapa">
                <div class="etapa-numero">{etapa.paso}</div>
                <h3>{etapa.titulo}</h3>
                <p>{etapa.texto}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Otras especies ------------------------------------------------ -->
    <section class="lud-seccion lud-hielo">
      <div class="lud-ancho otras">
        <div>
          <div class="lud-rotulo">{c.otras.rotulo}</div>
          <h2 class="lud-h2">{c.otras.titulo}</h2>
          <p class="lud-bajada">{c.otras.bajada}</p>
        </div>
        {
          planta && (
            <Image
              src={planta}
              alt=""
              widths={[600, 900, 1296]}
              sizes="(max-width: 900px) 100vw, 50vw"
              loading="lazy"
              class="otras-foto"
            />
          )
        }
      </div>
    </section>

    <!-- Contacto ------------------------------------------------------ -->
    <section class="lud-seccion lud-oscuro" id="contact">
      <div class="lud-ancho contacto">
        <div>
          <div class="lud-rotulo">{c.contacto.rotulo}</div>
          <h2 class="lud-h2">
            {
              c.contacto.titulo.map((linea, i) => (
                <>
                  {i > 0 && <br />}
                  {linea}
                </>
              ))
            }
          </h2>
          <p class="lud-bajada">{c.contacto.bajada}</p>
          <div class="contacto-datos">
            <div>
              <span class="dato-rotulo">{c.contacto.email}</span>
              <a href="mailto:info@ludrimar.cl">info@ludrimar.cl</a>
            </div>
            <div>
              <span class="dato-rotulo">{c.contacto.planta}</span>
              <span>{c.contacto.direccion}</span>
            </div>
          </div>
        </div>

        <div class="columna-formulario">
          <form class="formulario" id="lud-form" novalidate>
            <div class="campo-doble">
              <label>
                {c.contacto.campos.empresa}
                <input
                  type="text"
                  name="company"
                  placeholder={c.contacto.marcadores.empresa}
                  required
                />
              </label>
              <label>
                {c.contacto.campos.pais}
                <input type="text" name="country" placeholder={c.contacto.marcadores.pais} required />
              </label>
            </div>
            <div class="campo-doble">
              <label>
                {c.contacto.campos.nombre}
                <input type="text" name="name" placeholder={c.contacto.marcadores.nombre} required />
              </label>
              <label>
                {c.contacto.campos.correo}
                <input
                  type="email"
                  name="email"
                  placeholder={c.contacto.marcadores.correo}
                  required
                />
              </label>
            </div>
            <div class="campo-doble">
              <label>
                {c.contacto.campos.producto}
                <select name="product">
                  {c.contacto.productos.map((producto) => <option>{producto}</option>)}
                </select>
              </label>
              <label>
                {c.contacto.campos.volumen}
                <input type="text" name="volume" placeholder={c.contacto.marcadores.volumen} />
              </label>
            </div>
            <label>
              {c.contacto.campos.mensaje}
              <textarea name="message" rows="3" placeholder={c.contacto.marcadores.mensaje}
              ></textarea>
            </label>
            <button type="submit" class="lud-boton lud-boton-primario">
              {c.contacto.enviar} <span aria-hidden="true">↗</span>
            </button>
            <p class="formulario-nota">{c.contacto.nota}</p>
          </form>

          <div class="formulario-ok" id="lud-ok" hidden>
            <div class="ok-marca" aria-hidden="true">✓</div>
            <h3>{c.contacto.okTitulo}</h3>
            <p>{c.contacto.okTexto}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Pie ----------------------------------------------------------- -->
    <footer class="pie">
      <div class="lud-ancho pie-grid">
        <div>
          <Image
            src={lockupColor}
            alt="Pesquera Ludrimar Ltda"
            width={195}
            height={46}
            densities={[1, 2]}
          />
        </div>
        <div class="pie-texto">
          <p>{c.pie.descripcion}</p>
          <p><a href="mailto:info@ludrimar.cl">info@ludrimar.cl</a></p>
        </div>
        <div class="pie-legal">{c.pie.legal}</div>
      </div>
    </footer>
  </div>
</PropuestaLayout>

<style>
  /* Cabecera ------------------------------------------------------- */
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 16px var(--pad-x);
    background: rgba(12, 35, 57, 0.92);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--linea-oscura);
  }

  .marca :global(img) {
    display: block;
    height: auto;
  }

  .nav {
    display: flex;
    gap: clamp(16px, 2.2vw, 34px);
    font-size: 14px;
    font-weight: 500;
  }

  .nav a {
    color: rgba(255, 255, 255, 0.86);
  }

  .nav a:hover {
    color: var(--marea-clara);
  }

  .acciones {
    display: flex;
    align-items: center;
    gap: 16px;
    flex: none;
  }

  .idiomas {
    display: flex;
    align-items: center;
    gap: 2px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .idioma {
    padding: 6px 9px;
    border-radius: 3px;
    color: rgba(255, 255, 255, 0.68);
  }

  .idioma:hover {
    color: var(--blanco);
  }

  .idioma.activo {
    color: var(--blanco);
    background: rgba(255, 255, 255, 0.12);
  }

  .cta-cabecera {
    padding: 12px 20px;
    font-size: 14px;
  }

  /* Portada -------------------------------------------------------- */
  .portada {
    position: relative;
    overflow: hidden;
    background: linear-gradient(165deg, #0c2339 0%, #10314e 55%, #153b5f 100%);
    color: var(--blanco);
    padding: clamp(72px, 10vw, 148px) var(--pad-x) clamp(64px, 8vw, 120px);
  }

  .marca-agua {
    position: absolute;
    right: -6%;
    top: 50%;
    transform: translateY(-50%);
    width: min(56%, 720px);
    height: auto;
    opacity: 0.07;
    pointer-events: none;
  }

  .portada-texto {
    position: relative;
    max-width: var(--ancho);
    margin: 0 auto;
  }

  .portada h1 {
    font-size: clamp(40px, 5.2vw, 72px);
    line-height: 1.05;
    letter-spacing: -0.018em;
    margin-bottom: 30px;
    max-width: 17ch;
  }

  .portada-botones {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin: 36px 0 28px;
  }

  .portada-pie {
    font-size: 13.5px;
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.72);
  }

  /* Cifras --------------------------------------------------------- */
  .cifras {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
    background: var(--azul);
    color: var(--blanco);
  }

  .cifra {
    padding: 32px clamp(20px, 3vw, 44px);
    border-right: 1px solid rgba(255, 255, 255, 0.12);
  }

  .cifra:last-child {
    border-right: none;
  }

  .cifra-valor {
    font-family: var(--fuente-titulo);
    font-optical-sizing: auto;
    font-size: 34px;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-bottom: 10px;
    color: var(--marea-clara);
  }

  .cifra-texto {
    font-size: 14.5px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
  }

  /* Encabezado de sección ------------------------------------------ */
  .encabezado {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: clamp(24px, 4vw, 64px);
    align-items: end;
    margin-bottom: clamp(36px, 5vw, 64px);
  }

  /* Cortes --------------------------------------------------------- */
  .cortes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: clamp(18px, 2vw, 28px);
  }

  .corte {
    border: 1px solid var(--linea);
    border-radius: 6px;
    overflow: hidden;
    background: var(--blanco);
  }

  .corte :global(.corte-foto) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .corte-texto {
    padding: 22px 24px 26px;
  }

  .corte h3 {
    font-size: 23px;
    margin-bottom: 6px;
  }

  .corte-bajada {
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--marea-texto);
    margin-bottom: 14px;
  }

  .corte p {
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--texto);
  }

  /* Ficha técnica --------------------------------------------------- */
  .especificaciones {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }

  .ficha-cta {
    margin-top: 28px;
  }

  .tabla {
    margin: 0;
    border-top: 1px solid var(--linea);
  }

  .fila {
    display: grid;
    grid-template-columns: minmax(140px, 0.7fr) 1fr;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--linea);
  }

  .fila dt {
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--texto-tenue);
  }

  .fila dd {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 15.5px;
    font-weight: 500;
    color: var(--tinta);
  }

  /* Calidad -------------------------------------------------------- */
  .calidad {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 1px;
    background: var(--linea-oscura);
    border: 1px solid var(--linea-oscura);
  }

  .calidad article {
    background: var(--azul-hondo);
    padding: clamp(24px, 2.6vw, 34px);
  }

  .calidad h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font-size: 20px;
    margin-bottom: 12px;
  }

  .calidad p {
    font-size: 15.5px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.8);
  }

  /* Proceso -------------------------------------------------------- */
  .proceso {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
    gap: clamp(20px, 3vw, 40px);
  }

  .etapa {
    padding-top: 22px;
    border-top: 2px solid var(--azul);
  }

  .etapa-numero {
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--marea-texto);
    margin-bottom: 14px;
  }

  .etapa h3 {
    font-size: 22px;
    margin-bottom: 12px;
  }

  .etapa p {
    font-size: 15.5px;
    line-height: 1.7;
    color: var(--texto);
  }

  /* Otras especies -------------------------------------------------- */
  .otras {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: clamp(28px, 4vw, 64px);
    align-items: center;
  }

  .otras :global(.otras-foto) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 6px;
  }

  /* Contacto ------------------------------------------------------- */
  .contacto {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }

  .contacto-datos {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 36px;
    padding-top: 28px;
    border-top: 1px solid var(--linea-oscura);
  }

  .contacto-datos > div {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    font-size: 15px;
  }

  .dato-rotulo {
    min-width: 72px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.65);
  }

  .contacto-datos a {
    color: var(--marea-clara);
    font-weight: 500;
  }

  .columna-formulario {
    display: flex;
    flex-direction: column;
  }

  .formulario {
    display: flex;
    flex-direction: column;
    gap: 16px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--linea-oscura);
    border-radius: 6px;
    padding: clamp(24px, 3vw, 36px);
  }

  .campo-doble {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr));
    gap: 16px;
  }

  .formulario label {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 13.5px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.92);
  }

  .formulario input,
  .formulario select,
  .formulario textarea {
    width: 100%;
    padding: 13px 15px;
    background: rgba(6, 22, 38, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 4px;
    color: var(--blanco);
    font-family: var(--fuente-texto);
    font-size: 15px;
    font-weight: 400;
  }

  .formulario textarea {
    resize: vertical;
  }

  .formulario input::placeholder,
  .formulario textarea::placeholder {
    color: rgba(255, 255, 255, 0.55);
  }

  .formulario input:focus,
  .formulario select:focus,
  .formulario textarea:focus {
    outline: none;
    border-color: var(--marea-clara);
    box-shadow: 0 0 0 3px rgba(127, 215, 232, 0.2);
  }

  .formulario button {
    justify-content: center;
  }

  .formulario-nota {
    font-size: 12.5px;
    color: rgba(255, 255, 255, 0.62);
  }

  .formulario-ok {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(11, 159, 192, 0.5);
    border-radius: 6px;
    padding: clamp(24px, 3vw, 36px);
    justify-content: center;
  }

  .ok-marca {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--marea);
    color: var(--blanco);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
  }

  .formulario-ok p {
    color: rgba(255, 255, 255, 0.82);
  }

  /* Pie ------------------------------------------------------------ */
  .pie {
    background: var(--blanco);
    border-top: 1px solid var(--linea);
    padding: 40px var(--pad-x);
  }

  .pie-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 24px;
    align-items: center;
  }

  .pie-texto {
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--texto);
  }

  .pie-texto a {
    color: var(--marea-texto);
    font-weight: 600;
  }

  .pie-legal {
    font-size: 13.5px;
    color: var(--texto-tenue);
    text-align: right;
  }

  @media (max-width: 900px) {
    .nav {
      display: none;
    }

    .pie-legal {
      text-align: left;
    }
  }
</style>

<script>
  // Demo: el formulario no envía a ninguna parte, solo muestra la confirmación.
  const form = document.getElementById('lud-form') as HTMLFormElement | null;
  const ok = document.getElementById('lud-ok');

  form?.addEventListener('submit', (evento) => {
    evento.preventDefault();
    const obligatorios = form.querySelectorAll<HTMLInputElement>('[required]');
    for (const campo of obligatorios) {
      if (!campo.value.trim()) {
        campo.focus();
        campo.reportValidity();
        return;
      }
    }
    form.hidden = true;
    ok?.removeAttribute('hidden');
  });
</script>
