    margin-top: 10px !important;
    font-size: 12.5px;
    color: rgba(243, 239, 230, 0.62);
  }

  /* Responsive -------------------------------------------------------- */
  @media (max-width: 1080px) {
    .nav {
      display: none;
    }

    .certificaciones {
      grid-template-columns: repeat(3, 1fr);
    }

    .certificaciones li:nth-child(4) {
      border-left: 0;
    }

    .certificaciones li:nth-child(n + 4) {
      border-top: 1px solid var(--linea-oscura);
    }

    .grilla,
    .packs {
      grid-template-columns: repeat(2, 1fr);
    }

    .cocina-puntos {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 860px) {
    .portada {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .portada-foto {
      min-height: 0;
      aspect-ratio: 4 / 4.2;
    }

    .suscripcion-grilla,
    .mayoristas-grilla,
    .cocina-grilla,
    .resenas-grilla {
      grid-template-columns: 1fr;
    }

    .formulario-caja {
      position: static;
    }

    .instagram-grilla {
      grid-template-columns: repeat(3, 1fr);
    }

    .pie-grilla {
      grid-template-columns: 1fr 1fr;
    }

    .pie-marca {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 600px) {
    .cabecera {
      gap: 12px;
      padding-top: 12px;
      padding-bottom: 12px;
    }

    .marca img {
      width: 92px;
    }

    .modo button {
      padding: 7px 10px;
      font-size: 10.5px;
    }

    .certificaciones {
      grid-template-columns: 1fr 1fr;
    }

    .certificaciones li {
      padding: 16px 18px;
    }

    .certificaciones li:nth-child(n) {
      border-left: 0;
      border-top: 1px solid var(--linea-oscura);
    }

    .certificaciones li:nth-child(even) {
      border-left: 1px solid var(--linea-oscura);
    }

    .certificaciones li:nth-child(-n + 2) {
      border-top: 0;
    }

    .packs {
      grid-template-columns: 1fr;
    }

    /* En el celular, dos por fila como en cualquier tienda: foto, nombre y precio. */
    .grilla {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .producto-cuerpo {
      padding: 14px 14px 16px;
    }

    .producto h3 {
      font-size: 17px;
      overflow-wrap: anywhere;
    }

    .producto p {
      display: none;
    }

    .producto-pie {
      flex-direction: column;
      align-items: stretch;
      padding-top: 12px;
    }

    .producto .precio-valor {
      font-size: 22px;
    }

    .agregar {
      width: 100%;
    }

    .campos {
      grid-template-columns: 1fr;
    }

    .condiciones div {
      grid-template-columns: 1fr;
      gap: 2px;
    }

    .burbujas li:nth-child(2) {
      align-self: auto;
    }

    .carro {
      right: 12px;
      bottom: 12px;
      width: calc(100vw - 24px);
    }
  }
</style>

<script>
  type Modo = 'unidad' | 'mayorista';

  const raiz = document.querySelector<HTMLElement>('.tienda');

  if (raiz) {
    const DESPACHO_GRATIS = Number(raiz.dataset.despacho);
    const PEDIDO_MINIMO = Number(raiz.dataset.minimo);
    const formato = (monto: number) => `$${Math.round(monto).toLocaleString('es-CL')}`;

    // Un carro por modo: el público y el mayorista no se mezclan.
    const carros: Record<Modo, { cantidad: number; total: number }> = {
      unidad: { cantidad: 0, total: 0 },
      mayorista: { cantidad: 0, total: 0 },
    };
    const ultimo: Record<Modo, string> = { unidad: '', mayorista: '' };

    const carro = document.getElementById('carro');
    const $ = <T extends HTMLElement>(selector: string) => raiz.querySelector<T>(selector);

    const modoActual = () => (raiz.dataset.modo as Modo) ?? 'unidad';

    function pintarCarro(abrir = false) {
      const modo = modoActual();
      const { cantidad, total } = carros[modo];
      const mayorista = modo === 'mayorista';

      const contador = $('[data-carro-cantidad]');
      if (contador) contador.textContent = String(cantidad);

      if (!carro) return;
      if (cantidad === 0) {
        carro.hidden = true;
        return;
      }
      if (abrir) carro.hidden = false;

      const meta = mayorista ? PEDIDO_MINIMO : DESPACHO_GRATIS;
      const falta = Math.max(0, meta - total);

      $('[data-carro-titulo]')!.textContent = mayorista ? 'Pedido mayorista' : 'Tu carro';
      $('[data-carro-ultimo]')!.textContent = ultimo[modo] ? `Agregaste: ${ultimo[modo]}` : '';
      $('[data-carro-detalle]')!.textContent = mayorista
        ? `${cantidad} ${cantidad === 1 ? 'caja' : 'cajas'} · neto`
        : `${cantidad} ${cantidad === 1 ? 'producto' : 'productos'}`;
      $('[data-carro-total]')!.textContent = mayorista ? `${formato(total)} + IVA` : formato(total);
      $<HTMLElement>('[data-carro-progreso]')!.style.width = `${Math.min(100, (total / meta) * 100)}%`;
      $('[data-carro-meta]')!.textContent = mayorista
        ? falta > 0
          ? `Te faltan ${formato(falta)} para el pedido mínimo de ${formato(PEDIDO_MINIMO)} + IVA.`
          : 'Llegaste al pedido mínimo. Puedes pagar con transferencia o Webpay.'
        : falta > 0
          ? `Te faltan ${formato(falta)} para el despacho gratis en Santiago.`
          : 'Tienes despacho gratis en Santiago.';

      const pagar = $<HTMLButtonElement>('[data-carro-pagar]');
      if (pagar) pagar.disabled = mayorista && falta > 0;
      $('[data-carro-demo]')!.hidden = true;
    }

    // Unidad o mayorista
    function cambiarModo(modo: Modo) {
      raiz!.dataset.modo = modo;
      raiz!.querySelectorAll<HTMLButtonElement>('[data-modo-boton]').forEach((boton) => {
        boton.setAttribute('aria-pressed', String(boton.dataset.modoBoton === modo));
      });
      pintarCarro();
    }

    raiz.querySelectorAll<HTMLButtonElement>('[data-modo-boton]').forEach((boton) => {
      boton.addEventListener('click', () => cambiarModo(boton.dataset.modoBoton as Modo));
    });

    $('[data-ver-mayorista]')?.addEventListener('click', () => {
      cambiarModo('mayorista');
      document.getElementById('tienda')?.scrollIntoView({ behavior: 'smooth' });
    });

    // Filtro por línea
    const botonesFiltro = raiz.querySelectorAll<HTMLButtonElement>('[data-filtro]');
    botonesFiltro.forEach((boton) => {
      boton.addEventListener('click', () => {
        const filtro = boton.dataset.filtro;
        botonesFiltro.forEach((b) => b.setAttribute('aria-pressed', String(b === boton)));
        raiz.querySelectorAll<HTMLElement>('.producto').forEach((producto) => {
          producto.hidden = filtro !== 'todo' && producto.dataset.linea !== filtro;
        });
      });
    });

    // Agregar al carro
    raiz.querySelectorAll<HTMLButtonElement>('[data-agregar]').forEach((boton) => {
      boton.addEventListener('click', () => {
        const modo = modoActual();
        const precio = Number(modo === 'mayorista' ? boton.dataset.caja : boton.dataset.unidad);
        carros[modo].cantidad += 1;
        carros[modo].total += precio;
        ultimo[modo] = boton.dataset.nombre ?? '';
        boton.classList.add('listo');
        setTimeout(() => boton.classList.remove('listo'), 700);
        pintarCarro(true);
      });
    });

    $('[data-abrir-carro]')?.addEventListener('click', () => {
      if (carros[modoActual()].cantidad > 0) pintarCarro(true);
      else document.getElementById('tienda')?.scrollIntoView({ behavior: 'smooth' });
    });

    $('[data-cerrar-carro]')?.addEventListener('click', () => {
      if (carro) carro.hidden = true;
    });

    $('[data-carro-pagar]')?.addEventListener('click', () => {
      $('[data-carro-demo]')!.hidden = false;
    });

    // Demo: el formulario no envía a ninguna parte, solo muestra la confirmación.
    const form = document.getElementById('shiva-form') as HTMLFormElement | null;
    const ok = document.getElementById('shiva-ok');

    form?.addEventListener('submit', (evento) => {
      evento.preventDefault();
      const obligatorios = form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[required]');
      for (const campo of obligatorios) {
        if (!campo.checkValidity()) {
          campo.focus();
          campo.reportValidity();
          return;
        }
      }
      form.hidden = true;
      ok?.removeAttribute('hidden');
    });
  }
</script>
