---
import { Image } from 'astro:assets';
import PropuestaLayout from '../layouts/PropuestaLayout.astro';
// Titulares gruesos y algo angostos, como los de las piezas de Shiva: Archivo
// con eje de ancho. La cursiva serif es la del remate (“La mesa se arma sola.”).
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/playfair-display/wght-italic.css';
import '@fontsource-variable/readex-pro';
import '@fontsource-variable/jetbrains-mono';
import '../styles/shiva.css';
import {
  CERTIFICACIONES,
  DESPACHO_GRATIS_DESDE,
  LINEAS,
  PACKS,
  PEDIDO_MINIMO,
  PRODUCTOS,
  RESENAS,
  RUTAS,
  TIPOS_NEGOCIO,
  UNIDADES_CAJA,
  clp,
  precioMayoristaCaja,
  precioMayoristaUnidad,
  precioSueltoPack,
  precioSuscripcion,
  producto,
  unidadesPack,
} from '../data/shiva';
import { cargarImagen } from '../lib/imagenes';
import logoBlanco from '../assets/shiva/shiva-logo-blanco.png';
import despensa from '../assets/shiva/fotos/despensa.jpg';
import cajaPedido from '../assets/shiva/fotos/caja-pedido.jpg';
import tostaditasMesa from '../assets/shiva/fotos/tostaditas-mesa.jpg';
import ingredientesMediterraneas from '../assets/shiva/fotos/ingredientes-mediterraneas.webp';
import ingredientesCookies from '../assets/shiva/fotos/ingredientes-cookies.webp';
import ingredientesSarraceno from '../assets/shiva/fotos/ingredientes-sarraceno.webp';
import porcionPimenton from '../assets/shiva/fotos/porcion-pimenton.webp';

const productos = await Promise.all(
  PRODUCTOS.map(async (p) => ({
    ...p,
    foto: await cargarImagen(p.imagen),
    linea: LINEAS.find((l) => l.id === p.linea)?.nombre ?? '',
    lineaId: p.linea,
    suscripcion: precioSuscripcion(p.precio),
    caja: precioMayoristaCaja(p.precio),
    unidadNeta: precioMayoristaUnidad(p.precio),
  }))
);

const fotosProducto = Object.fromEntries(productos.map((p) => [p.id, p.foto]));

const packs = PACKS.map((pack) => {
  const suelto = precioSueltoPack(pack);
  return {
    ...pack,
    unidades: unidadesPack(pack),
    suelto,
    ahorro: Math.round((1 - pack.precio / suelto) * 100),
    fotos: Object.keys(pack.contenido)
      .slice(0, 3)
      .map((id) => ({ foto: fotosProducto[id], nombre: producto(id).nombre })),
  };
});

const instagram = [
  { src: despensa, alt: 'Paquete de crackers Mix de Semillas en una despensa' },
  { src: tostaditasMesa, alt: 'Tostaditas Limón y Jalapeño sobre la mesa' },
  { src: ingredientesMediterraneas, alt: 'Ingredientes de las crackers Mediterráneas' },
  { src: porcionPimenton, alt: 'Lo que aporta una porción de crackers Pimentón Ahumado' },
  { src: ingredientesCookies, alt: 'Ingredientes de las cookies' },
  { src: ingredientesSarraceno, alt: 'Ingredientes de las tostaditas de trigo sarraceno' },
];

const nav = [
  { texto: 'Tienda', href: '#tienda' },
  { texto: 'Packs', href: '#packs' },
  { texto: 'Suscripción', href: '#suscripcion' },
  { texto: 'Mayoristas', href: '#mayoristas' },
  { texto: 'Nuestra cocina', href: '#cocina' },
];
---

<PropuestaLayout
  title="Shiva Chile — tienda online | Demo de Ojos Publicitarios"
  description="Demo de la tienda shivacocina.cl: venta por unidad, packs, suscripción y canal mayorista para el lanzamiento de Shiva en Chile."
  cliente="Shiva · shivacocina.cl"
  etiqueta="Demo de tienda"
  nota="Precios referenciales en CLP · fotos de Shiva Argentina"
  fondo="#0f0f0e"
>
  <div
    class="shiva tienda"
    data-modo="unidad"
    data-despacho={DESPACHO_GRATIS_DESDE}
    data-minimo={PEDIDO_MINIMO}
  >
    <div class="aviso">
      <span>Shiva llegó a Chile</span>
      <span class="aviso-sep" aria-hidden="true">/</span>
      <span>Despacho gratis en Santiago desde {clp(DESPACHO_GRATIS_DESDE)}</span>
      <a href={RUTAS.propuesta} class="aviso-propuesta">Ver la propuesta ↗</a>
    </div>

    <!-- Cabecera ------------------------------------------------------ -->
    <header class="cabecera shiva-oscuro">
      <a href="#inicio" class="marca" aria-label="Shiva, ir al inicio">
        <Image src={logoBlanco} alt="" width={118} densities={[1, 2]} loading="eager" />
      </a>
      <nav class="nav" aria-label="Secciones">
        {nav.map((item) => <a href={item.href}>{item.texto}</a>)}
      </nav>
      <div class="acciones">
        <div class="modo" role="group" aria-label="Tipo de compra">
          <button type="button" data-modo-boton="unidad" aria-pressed="true">Unidad</button>
          <button type="button" data-modo-boton="mayorista" aria-pressed="false">Mayorista</button>
        </div>
        <button type="button" class="carro-icono" data-abrir-carro aria-label="Ver el carro">
          <svg viewBox="0 0 24 24" width="21" height="21" aria-hidden="true">
            <path
              d="M3 4h2.2l2.1 10.2a1.6 1.6 0 0 0 1.6 1.3h8.4a1.6 1.6 0 0 0 1.6-1.2L20.6 8H6.1"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
            <circle cx="9.5" cy="19.5" r="1.3" fill="currentColor"></circle>
            <circle cx="17" cy="19.5" r="1.3" fill="currentColor"></circle>
          </svg>
          <span class="carro-cantidad" data-carro-cantidad>0</span>
        </button>
      </div>
    </header>

    <!-- Portada ------------------------------------------------------- -->
    <section class="portada shiva-oscuro" id="inicio">
      <div class="portada-texto">
        <div class="shiva-rotulo">Sin gluten · Plant-based · Kosher</div>
        <h1>
          El snack<br />del futuro<br /><span class="shiva-serif">llegó a Chile.</span>
        </h1>
        <p class="shiva-bajada">
          Crackers, tostaditas y cookies con masa madre, hechas de forma artesanal con ingredientes
          que conoces. Sin conservantes, veganas y aptas para personas con APLV.
        </p>
        <div class="portada-botones">
          <a href="#tienda" class="shiva-boton shiva-boton-oro">Comprar ahora</a>
          <a href="#mayoristas" class="shiva-boton shiva-boton-borde">Vender Shiva en mi tienda</a>
        </div>
      </div>
      <div class="portada-foto">
        <Image
          src={despensa}
          alt="Mano sacando un paquete de crackers Shiva Mix de Semillas de una despensa"
          widths={[600, 900, 1300]}
          sizes="(max-width: 860px) 100vw, 45vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </section>

    <!-- Certificaciones ----------------------------------------------- -->
    <ul class="certificaciones" aria-label="Certificaciones">
      {
        CERTIFICACIONES.map((c) => (
          <li>
            <strong>{c.titulo}</strong>
            <span>{c.texto}</span>
          </li>
        ))
      }
    </ul>

    <!-- Tienda -------------------------------------------------------- -->
    <section class="shiva-seccion" id="tienda">
      <div class="shiva-ancho">
        <div class="encabezado">
          <div>
            <div class="shiva-rotulo">La tienda · 9 sabores · 100 g</div>
            <h2 class="shiva-h2">Elige tu <span class="shiva-serif">favorito.</span></h2>
          </div>
          <div class="filtros" role="group" aria-label="Filtrar por línea">
            <button type="button" data-filtro="todo" aria-pressed="true">Todo</button>
            {
              LINEAS.map((l) => (
                <button type="button" data-filtro={l.id} aria-pressed="false">
                  {l.nombre}
                </button>
              ))
            }
          </div>
        </div>

        <div class="aviso-mayorista" data-solo="mayorista">
          <strong>Estás viendo la tabla mayorista.</strong> Precios netos por caja de {UNIDADES_CAJA},
          con pedido mínimo de {clp(PEDIDO_MINIMO)} + IVA. En la tienda real solo los ve una cuenta
          aprobada, al iniciar sesión.
        </div>

        <p class="nota-sellos">
          <span class="shiva-pendiente"
            >Cada ficha mostrará los sellos “ALTO EN” de la etiqueta chilena y la tabla nutricional</span
          >
        </p>

        <ul class="grilla">
          {
            productos.map((p) => (
              <li class="producto" data-linea={p.lineaId}>
                <div class="producto-foto">
                  {p.foto && (
                    <Image
                      src={p.foto}
                      alt={`${p.linea} Shiva ${p.nombre}, paquete de 100 g`}
                      widths={[360, 560, 800]}
                      sizes="(max-width: 600px) 100vw, (max-width: 1000px) 50vw, 33vw"
                      loading="lazy"
                    />
                  )}
                </div>
                <div class="producto-cuerpo">
                  <div class="producto-linea">{p.linea}</div>
                  <h3>{p.nombre}</h3>
                  <p>{p.texto}</p>
                  <div class="producto-pie">
                    <div class="precio" data-solo="unidad">
                      <span class="precio-valor">{clp(p.precio)}</span>
                      <span class="precio-sub">{clp(p.suscripcion)} con suscripción</span>
                    </div>
                    <div class="precio" data-solo="mayorista">
                      <span class="precio-valor">
                        {clp(p.caja)} <small>+ IVA</small>
                      </span>
                      <span class="precio-sub">
                        Caja de {UNIDADES_CAJA} · {clp(p.unidadNeta)} neto c/u · venta sugerida{' '}
                        {clp(p.precio)}
                      </span>
                    </div>
                    <button
                      type="button"
                      class="agregar"
                      data-agregar
                      data-nombre={p.nombre}
                      data-unidad={p.precio}
                      data-caja={p.caja}
                    >
                      <span data-solo="unidad">Agregar</span>
                      <span data-solo="mayorista">Agregar caja</span>
                    </button>
                  </div>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Packs --------------------------------------------------------- -->
    <section class="shiva-seccion shiva-papel" id="packs" data-solo="unidad">
      <div class="shiva-ancho">
        <div class="encabezado">
          <div>
            <div class="shiva-rotulo">Packs</div>
            <h2 class="shiva-h2">La mesa se <span class="shiva-serif">arma sola.</span></h2>
          </div>
          <p class="shiva-bajada">
            Para el picoteo, la once y la despensa. Más paquetes, mejor precio, y todos llegan con un
            regalo de la marca.
          </p>
        </div>

        <div class="packs">
          {
            packs.map((pack) => (
              <article class="pack">
                <div class="pack-fotos" aria-hidden="true">
                  {pack.fotos.map(
                    (f) =>
                      f.foto && <Image src={f.foto} alt="" width={260} densities={[1, 2]} loading="lazy" />
                  )}
                </div>
                <div class="pack-cuerpo">
                  <div class="pack-cabeza">
                    <h3>{pack.nombre}</h3>
                    <span class="pack-unidades">{pack.unidades} paquetes</span>
                  </div>
                  <p>{pack.bajada}</p>
                  <div class="producto-pie">
                    <div class="precio">
                      <span class="precio-valor">{clp(pack.precio)}</span>
                      <span class="precio-sub">
                        <s>{clp(pack.suelto)}</s> · ahorras {pack.ahorro} %
                      </span>
                    </div>
                    <button
                      type="button"
                      class="agregar"
                      data-agregar
                      data-nombre={pack.nombre}
                      data-unidad={pack.precio}
                      data-caja={pack.precio}
                    >
                      Agregar
                    </button>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Suscripción --------------------------------------------------- -->
    <section class="shiva-seccion shiva-oscuro suscripcion" id="suscripcion" data-solo="unidad">
      <div class="shiva-ancho suscripcion-grilla">
        <div>
          <div class="shiva-rotulo">Suscripción</div>
          <h2 class="shiva-h2">Que nunca <span class="shiva-serif">falten.</span></h2>
          <p class="shiva-bajada">
            Suscríbete y paga 10 % menos en cada envío. Es la misma suscripción que ya usan los
            clientes de Shiva en Argentina, ahora con despacho en Chile.
          </p>
        </div>
        <ol class="pasos">
          <li>
            <span class="paso-numero">01</span>
            <div>
              <h3>Elige tus sabores</h3>
              <p>Arma tu caja con los que más te gustan, o deja que te sorprendamos.</p>
            </div>
          </li>
          <li>
            <span class="paso-numero">02</span>
            <div>
              <h3>Elige cada cuánto</h3>
              <p>Cada 30 o cada 60 días, directo a tu casa.</p>
            </div>
          </li>
          <li>
            <span class="paso-numero">03</span>
            <div>
              <h3>Pausa cuando quieras</h3>
              <p>Sin permanencia: cambias, pausas o cancelas desde tu cuenta.</p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <!-- Mayoristas ---------------------------------------------------- -->
    <section class="shiva-seccion mayoristas" id="mayoristas">
      <div class="shiva-ancho mayoristas-grilla">
        <div class="mayoristas-info">
          <div class="shiva-rotulo">Mayoristas</div>
          <h2 class="shiva-h2">Vende Shiva <span class="shiva-serif">en tu tienda.</span></h2>
          <p class="shiva-bajada">
            Para tiendas saludables, almacenes, cafeterías y gimnasios. Te registras con el RUT de tu
            empresa, aprobamos tu cuenta y compras online, con precios netos y factura.
          </p>

          <div class="condiciones-cabeza">
            <span class="shiva-pendiente">Condiciones referenciales, por confirmar</span>
          </div>
          <dl class="condiciones">
            <div>
              <dt>Formato</dt>
              <dd>Caja de {UNIDADES_CAJA} paquetes del mismo sabor, lista para el mesón.</dd>
            </div>
            <div>
              <dt>Precio</dt>
              <dd>Neto, con 35 % de margen sobre el precio de venta sugerido.</dd>
            </div>
            <div>
              <dt>Pedido mínimo</dt>
              <dd>{clp(PEDIDO_MINIMO)} + IVA, combinando sabores.</dd>
            </div>
            <div>
              <dt>Pago</dt>
              <dd>Transferencia o Webpay, con factura electrónica.</dd>
            </div>
            <div>
              <dt>Despacho</dt>
              <dd>Santiago en 48 h hábiles. Regiones por courier.</dd>
            </div>
            <div>
              <dt>Apoyo</dt>
              <dd>Exhibidor de mesón, degustación de lanzamiento y tu tienda en nuestras redes.</dd>
            </div>
          </dl>

          <button type="button" class="shiva-boton shiva-boton-negro" data-ver-mayorista>
            Ver la tabla mayorista
          </button>

          <div class="mayoristas-foto">
            <Image
              src={cajaPedido}
              alt="Caja abierta llena de paquetes de Shiva lista para despacho"
              widths={[500, 800]}
              sizes="(max-width: 900px) 100vw, 45vw"
              loading="lazy"
            />
          </div>
        </div>

        <div class="formulario-caja">
          <form class="formulario" id="shiva-form" novalidate>
            <h3>Solicita tu cuenta mayorista</h3>
            <p class="formulario-bajada">Te respondemos en 24 horas hábiles.</p>
            <div class="campos">
              <label>
                <span>Razón social *</span>
                <input name="razon" required autocomplete="organization" />
              </label>
              <label>
                <span>RUT de la empresa *</span>
                <input name="rut" required placeholder="76.123.456-7" />
              </label>
              <label>
                <span>Tipo de negocio *</span>
                <select name="tipo" required>
                  <option value="">Elige una opción</option>
                  {TIPOS_NEGOCIO.map((t) => <option>{t}</option>)}
                </select>
              </label>
              <label>
                <span>Comuna *</span>
                <input name="comuna" required placeholder="Providencia" />
              </label>
              <label>
                <span>Tu nombre *</span>
                <input name="nombre" required autocomplete="name" />
              </label>
              <label>
                <span>Correo *</span>
                <input name="correo" type="email" required autocomplete="email" />
              </label>
              <label>
                <span>WhatsApp</span>
                <input name="whatsapp" type="tel" autocomplete="tel" placeholder="+56 9" />
              </label>
              <label>
                <span>Cajas al mes</span>
                <select name="volumen">
                  <option>De 1 a 5</option>
                  <option>De 6 a 15</option>
                  <option>De 16 a 40</option>
                  <option>Más de 40</option>
                </select>
              </label>
            </div>
            <button type="submit" class="shiva-boton shiva-boton-oro enviar">Solicitar cuenta</button>
            <p class="formulario-nota">
              ¿Distribuidor o cadena? Escríbenos y te cotizamos por volumen.
            </p>
          </form>
          <div class="formulario-ok" id="shiva-ok" hidden>
            <div class="shiva-rotulo">Solicitud recibida</div>
            <h3>¡Gracias! Ya estás en la fila.</h3>
            <p>
              Revisamos tu RUT y te escribimos en menos de 24 horas hábiles con el acceso a la tabla
              mayorista.
            </p>
            <p class="formulario-nota">Demo: el formulario no envía datos a ninguna parte.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Nuestra cocina ------------------------------------------------ -->
    <section class="shiva-seccion shiva-oscuro cocina" id="cocina">
      <div class="shiva-ancho cocina-grilla">
        <div class="cocina-foto">
          <Image
            src={ingredientesMediterraneas}
            alt="Los ingredientes de las crackers Mediterráneas: harina de arroz, aceitunas, albahaca, semillas y aceite de oliva"
            widths={[500, 800]}
            sizes="(max-width: 900px) 100vw, 45vw"
            loading="lazy"
          />
        </div>
        <div>
          <div class="shiva-rotulo">Nuestra cocina</div>
          <blockquote class="cita">
            Creemos en lo artesanal <span class="shiva-serif">cuando suma</span> y en lo industrial{' '}
            <span class="shiva-serif">cuando no traiciona.</span>
          </blockquote>
          <ul class="cocina-puntos">
            <li>
              <strong>Masa madre</strong>
              <span>De harina de arroz, en las crackers y las tostaditas.</span>
            </li>
            <li>
              <strong>Ingredientes que conoces</strong>
              <span>Sin conservantes ni aditivos artificiales.</span>
            </li>
            <li>
              <strong>Fábrica certificada</strong>
              <span>Buenas Prácticas de Manufactura, certificadas por IRAM.</span>
            </li>
          </ul>
          <p class="merken">
            <span class="shiva-serif">Dato:</span> las Mediterráneas y las de Carbón Vegetal ya llevaban
            merkén antes de llegar a Chile.
          </p>
        </div>
      </div>
    </section>

    <!-- Reseñas ------------------------------------------------------- -->
    <section class="shiva-seccion resenas">
      <div class="shiva-ancho resenas-grilla">
        <div>
          <div class="shiva-rotulo">Reseñas</div>
          <h2 class="resenas-titulo shiva-serif">Lo que nos mandan.</h2>
          <p class="shiva-bajada">Mensajes reales de clientes en Argentina, mientras llegamos.</p>
        </div>
        <ul class="burbujas">
          {
            RESENAS.map((r) => (
              <li>
                <p>{r.texto}</p>
                <span>{r.origen} · Argentina</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Instagram ----------------------------------------------------- -->
    <section class="shiva-seccion shiva-papel instagram" id="redes">
      <div class="shiva-ancho">
        <div class="instagram-cabeza">
          <div>
            <div class="shiva-rotulo">Instagram · TikTok</div>
            <h2 class="shiva-h2">@shivacocina.cl</h2>
          </div>
          <a href="#inicio" class="shiva-boton shiva-boton-negro">Síguenos</a>
        </div>
        <ul class="instagram-grilla">
          {
            instagram.map((foto) => (
              <li>
                <Image
                  src={foto.src}
                  alt={foto.alt}
                  widths={[300, 500]}
                  sizes="(max-width: 700px) 50vw, 17vw"
                  loading="lazy"
                />
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Pie ----------------------------------------------------------- -->
    <footer class="pie shiva-oscuro">
      <div class="shiva-ancho pie-grilla">
        <div class="pie-marca">
          <Image src={logoBlanco} alt="Shiva" width={150} densities={[1, 2]} loading="lazy" />
          <p>Plant based / Gluten free. Ahora en Chile.</p>
        </div>
        <div>
          <h4>Tienda</h4>
          <a href="#tienda">Crackers</a>
          <a href="#tienda">Tostaditas</a>
          <a href="#tienda">Cookies</a>
          <a href="#packs">Packs</a>
        </div>
        <div>
          <h4>Ayuda</h4>
          <a href="#inicio">Despachos</a>
          <a href="#inicio">Cambios y devoluciones</a>
          <a href="#inicio">Preguntas frecuentes</a>
          <a href="#inicio">Términos y condiciones</a>
        </div>
        <div>
          <h4>Mayoristas</h4>
          <a href="#mayoristas">Solicitar cuenta</a>
          <a href="#mayoristas">Ingresar</a>
          <span class="shiva-pendiente">WhatsApp y correo en Chile</span>
        </div>
      </div>
      <div class="shiva-ancho pie-legal">
        <span>Webpay · Mercado Pago · Transferencia</span>
        <span>
          Importa y distribuye en Chile: <span class="shiva-pendiente">razón social y RUT del importador</span>
        </span>
      </div>
    </footer>

    <!-- Carro --------------------------------------------------------- -->
    <aside class="carro" id="carro" aria-label="Carro" aria-live="polite" hidden>
      <div class="carro-fila">
        <strong data-carro-titulo>Tu carro</strong>
        <button type="button" class="carro-cerrar" data-cerrar-carro aria-label="Cerrar el carro">×</button>
      </div>
      <div class="carro-ultimo" data-carro-ultimo></div>
      <div class="carro-total">
        <span data-carro-detalle></span>
        <strong data-carro-total></strong>
      </div>
      <div class="carro-barra"><span data-carro-progreso></span></div>
      <p class="carro-meta" data-carro-meta></p>
      <button type="button" class="shiva-boton shiva-boton-oro" data-carro-pagar>Ir a pagar</button>
      <p class="carro-demo" data-carro-demo hidden>
