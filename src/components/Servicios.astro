---
import SpotlightCard from './react/SpotlightCard.tsx';
import { SERVICIOS } from '../data/contenido';
---

<section id="servicios" class="seccion">
  <div class="encabezado" data-reveal-grupo="90">
    <h2 class="titulo-seccion">Una web a la altura de tu negocio.</h2>
    <p class="texto-apoyo">
      Si tu negocio todavía no tiene sitio ni redes, empezamos por ahí. No todos necesitan lo
      mismo: encontramos el formato que mejor conecta tu marca con su próximo cliente.
    </p>
  </div>

  <div class="rejilla">
    {
      SERVICIOS.map((servicio, i) => (
        <SpotlightCard
          client:visible
          revealDelay={i * 110}
          className={`svc-tarjeta${servicio.destacado ? ' destacada' : ''}`}
          spotlightColor={
            servicio.destacado ? 'rgba(0, 200, 230, 0.26)' : 'rgba(0, 200, 230, 0.16)'
          }
        >
          <div class="svc-fila">
            <span class="svc-numero">{servicio.numero}</span>
            {servicio.destacado && servicio.etiqueta ? (
              <span class="svc-insignia">{servicio.etiqueta}</span>
            ) : (
              <span class="svc-simbolo" aria-hidden="true">
                {servicio.simbolo ?? '↗'}
              </span>
            )}
          </div>

          <h3>{servicio.titulo}</h3>
          <div class="svc-bajada">{servicio.bajada}</div>
          <p>{servicio.descripcion}</p>

          <ul class="svc-lista">
            {servicio.puntos.map((punto) => (
              <li>
                <span aria-hidden="true">✓</span> {punto}
              </li>
            ))}
          </ul>

          <a
            class="svc-enlace"
            href="#contacto"
            data-track="cta_servicio"
            data-track-label={servicio.titulo}
          >
            {servicio.cta} <span aria-hidden="true">↗</span>
          </a>
        </SpotlightCard>
      ))
    }
  </div>
</section>

<style>
  .rejilla {
    --min-col: 290px;
  }
</style>
