    | 'escudo'
    | 'sello'
    | 'copo'
    | 'trazabilidad'
    | 'equipo'
    | 'certificado'
    | 'recepcion'
    | 'corte'
    | 'contenedor'
    | 'correo'
    | 'pin'
    | 'documento';
