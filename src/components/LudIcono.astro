  sello: 'M12 3.5 14 6l3.3-.2.6 3.2 2.6 2-1.6 2.9 1 3.2-3.2 1-1.8 2.7-3-1.3-3 1.3-1.8-2.7-3.2-1 1-3.2L3.5 11l2.6-2 .6-3.2L10 6l2-2.5Z M9.2 12.2l2 2 3.6-3.8',
