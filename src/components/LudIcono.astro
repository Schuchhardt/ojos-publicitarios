---

<svg
  class="lud-icono"
  width={tamano}
  height={tamano}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {TRAZOS[nombre].split(' M').map((d, i) => <path d={i === 0 ? d : `M${d}`} />)}
</svg>

<style>
  .lud-icono {
    display: block;
    flex: none;
  }
</style>
