  recepcion:
    'M4 13.5h4l1.2 2.2h5.6L16 13.5h4 M4 13.5 6.2 6h11.6L20 13.5v5.3a1.2 1.2 0 0 1-1.2 1.2H5.2A1.2 1.2 0 0 1 4 18.8v-5.3Z',
  corte:
    'M4.5 4.5 14 14 M19.5 4.5 10 14 M6.5 19.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z M17.5 19.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z',
  contenedor:
    'M3.5 8.5h13v8h-13v-8Z M16.5 11h2.6l1.4 3v2.5h-4V11Z M7 8.5v8M10 8.5v8M13 8.5v8 M6.5 19.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z M17.5 19.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z',
  correo: 'M3.5 6.5h17v11h-17v-11Z M3.8 7.2 12 13l8.2-5.8',
