---
import { Image } from 'astro:assets';
import mockup from '../assets/web/marketing.jpg';
import { HOME, type Idioma, type IconoMarketing } from '../data/home';

interface Props {
  idioma: Idioma;
}

const c = HOME[Astro.props.idioma].marketing;

// Íconos de línea, dibujados para esta sección (24×24, trazo celeste).
const ICONOS: Record<IconoMarketing, string> = {
  pluma:
    '<path d="M12 3v6"/><circle cx="12" cy="10.5" r="1.5"/><path d="M12 3 7.5 12.5 12 17l4.5-4.5L12 3Z"/><path d="M3 19.5c3-1 6-2.5 9-2.5s6 1.5 9 2.5"/><circle cx="3" cy="19.5" r="1.4"/><circle cx="21" cy="19.5" r="1.4"/>',
  chat:
    '<path d="M3 5.5A2.5 2.5 0 0 1 5.5 3h8A2.5 2.5 0 0 1 16 5.5v5a2.5 2.5 0 0 1-2.5 2.5H9l-4 3v-3.1A2.5 2.5 0 0 1 3 10.5v-5Z"/><path d="M16 8h2.5A2.5 2.5 0 0 1 21 10.5v5a2.5 2.5 0 0 1-2 2.45V21l-3.5-3H12a2.5 2.5 0 0 1-2.5-2.5V13"/><path d="M6.5 7h6M6.5 9.5h4"/>',
  megafono:
    '<path d="M3 10v4a1 1 0 0 0 1 1h3l8 4.5V4.5L7 9H4a1 1 0 0 0-1 1Z"/><path d="M7 15v4a1.5 1.5 0 0 0 3 0v-2.5"/><path d="M18.5 9a4 4 0 0 1 0 6M20.5 6.5a7.5 7.5 0 0 1 0 11"/>',
  lupa: '<circle cx="10" cy="10" r="6.5"/><path d="m15 15 6 6"/><path d="M7 9a3 3 0 0 1 3-3"/>',
  sobre: '<rect x="2.5" y="5" width="19" height="14" rx="2"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/>',
  barras:
    '<rect x="3.5" y="13" width="4" height="7.5" rx="1"/><rect x="10" y="8.5" width="4" height="12" rx="1"/><rect x="16.5" y="3.5" width="4" height="17" rx="1"/>',
};
---

<section id="marketing" class="marketing">
  <div class="contenedor">
    <div class="arriba">
      <div class="texto" data-reveal>
        <div class="rotulo">{c.rotulo}</div>
        <h2 class="titular">
          {c.titulo}
          <span>{c.tituloAcento}</span>
        </h2>
        <p>{c.texto}</p>
      </div>

      <div class="imagen" data-reveal style="--reveal-delay:120ms">
        <Image
          src={mockup}
          alt={c.alt}
          widths={[480, 760, 1080]}
          sizes="(max-width: 960px) 100vw, 55vw"
          loading="lazy"
        />
      </div>
    </div>

    <ul class="servicios" data-reveal-grupo="70">
      {
        c.servicios.map((servicio) => (
          <li>
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICONOS[servicio.icono]} />
            <div>
              <h3>{servicio.titulo}</h3>
              <p>{servicio.descripcion}</p>
            </div>
          </li>
        ))
      }
    </ul>

    <p class="pie" data-reveal>{c.pie}</p>
  </div>
</section>

<style>
  .marketing {
    background: #fff;
    color: var(--claro-texto);
    padding: var(--pad-y) var(--pad-x);
  }

  .arriba {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
    margin-bottom: clamp(40px, 5vw, 72px);
  }

  .rotulo {
    color: var(--claro-texto);
    font-weight: 500;
    font-size: 14px;
    letter-spacing: 0.24em;
    margin-bottom: 26px;
  }

  .titular {
    font-size: clamp(32px, 3.6vw, 50px);
  }

  .texto p {
    font-size: clamp(16px, 1.25vw, 18px);
    font-weight: 500;
    line-height: 1.65;
    color: var(--claro-texto-suave);
    margin: 26px 0 0;
    max-width: 40ch;
  }

  .imagen :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .servicios {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    list-style: none;
    margin: 0;
    padding: 18px 0;
    border-top: 1px solid var(--claro-linea);
    border-bottom: 1px solid var(--claro-linea);
  }

  .servicios li {
    display: flex;
    align-items: flex-start;
    gap: 18px;
    padding: 20px clamp(16px, 2vw, 28px);
    border-radius: var(--radio-tarjeta);
    transition: background 0.3s ease;
  }

  .servicios li:hover {
    background: #e8f7fe;
  }

  .servicios svg {
    width: 44px;
    height: 44px;
    flex: none;
    fill: none;
    stroke: var(--celeste);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.4s var(--curva);
  }

  .servicios li:hover svg {
    transform: scale(1.08) rotate(-4deg);
  }

  h3 {
    font-family: var(--fuente-texto);
    font-size: 18px;
    font-weight: 700;
    margin: 0 0 4px;
  }

  .servicios p {
    font-size: 15px;
    line-height: 1.5;
    color: var(--claro-texto-suave);
    margin: 0;
  }

  .pie {
    display: flex;
    align-items: center;
    gap: 24px;
    margin: 28px 0 0;
    font-size: 14px;
    letter-spacing: 0.08em;
    color: var(--claro-texto-suave);
    text-align: center;
  }

  .pie::before,
  .pie::after {
    content: '';
    flex: 1;
    height: 1px;
    background: #b9cfd8;
  }

  @media (max-width: 960px) {
    .arriba {
      grid-template-columns: minmax(0, 1fr);
    }

    .servicios {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .servicios {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 560px) {
    .pie::before,
    .pie::after {
      display: none;
    }

    .pie {
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .servicios svg {
      transition: none;
    }

    .servicios li:hover svg {
      transform: none;
    }
  }
</style>
