---
import { Image } from 'astro:assets';
import { HOME, type Idioma } from '../data/home';
import { cargarImagen } from '../lib/imagenes';

interface Props {
  idioma: Idioma;
}

const c = HOME[Astro.props.idioma].proyectos;

const proyectos = await Promise.all(
  c.lista.map(async (proyecto) => ({
    ...proyecto,
    imagen: await cargarImagen(proyecto.imagen),
  }))
);
---

<section id="proyectos" class="proyectos tema-claro">
  <div class="contenedor">
  <div class="encabezado" data-reveal-grupo="90">
    <h2 class="titulo-seccion">{c.titulo}</h2>
    <p class="texto-apoyo">{c.bajada}</p>
  </div>

  <div class="rejilla" data-reveal-grupo="110">
    {
      proyectos.map((proyecto) => (
        <article class="tarjeta">
          {proyecto.imagen && (
            <Image
              src={proyecto.imagen}
              alt={proyecto.nombre}
              widths={[420, 760, 1080]}
              sizes="(max-width: 900px) 100vw, 45vw"
              loading="lazy"
              style={`object-position: ${proyecto.encuadre === 'top' ? 'top center' : 'center'};`}
            />
          )}
          <div class="cuerpo">
            <div class="rotulo-proyecto">{proyecto.rotulo}</div>
            <h3>{proyecto.nombre}</h3>
            <p>{proyecto.descripcion}</p>
            <a
              href={proyecto.url}
              target="_blank"
              rel="noopener"
              data-track="proyecto"
              data-track-label={proyecto.nombre}
            >
              {proyecto.enlaceTexto ?? proyecto.url.replace('https://', '')} ↗
            </a>
          </div>
        </article>
      ))
    }
  </div>
  </div>
</section>

<style>
  .proyectos {
    padding: var(--pad-y) var(--pad-x);
  }

  .rejilla {
    --min-col: 260px;
    gap: clamp(20px, 2.6vw, 32px);
  }

  .tarjeta {
    border: 1px solid var(--linea-media);
    border-radius: var(--radio-tarjeta);
    background: var(--panel);
    overflow: hidden;
    transition:
      transform 0.45s var(--curva),
      border-color 0.4s ease;
  }

  .tarjeta:hover {
    transform: translateY(-4px);
    border-color: var(--acento-borde);
  }

  .tarjeta :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    transition: transform 0.7s var(--curva);
  }

  .tarjeta:hover :global(img) {
    transform: scale(1.04);
  }

  .cuerpo {
    padding: clamp(22px, 2.4vw, 32px);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .rotulo-proyecto {
    font-family: var(--fuente-titulo);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--acento);
  }

  h3 {
    font-family: var(--fuente-titulo);
    font-size: 24px;
    font-weight: 700;
    margin: 0;
  }

  p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--texto-apagado);
    margin: 0;
  }

  .cuerpo a {
    font-size: 14px;
    font-weight: 600;
    margin-top: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .tarjeta,
    .tarjeta :global(img) {
      transition: none;
    }

    .tarjeta:hover {
      transform: none;
    }

    .tarjeta:hover :global(img) {
      transform: none;
    }
  }
</style>
