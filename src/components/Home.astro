---
// La home completa, en el idioma que se le pida. Las páginas `/` y `/en/` solo
// eligen el idioma; el orden de las secciones sigue el diseño
// (PAGINA WEB 2_diseño.pdf) con los bloques del sitio anterior intercalados.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Franja from './Franja.astro';
import Unico from './Unico.astro';
import Servicios from './Servicios.astro';
import Software from './Software.astro';
import Industrias from './Industrias.astro';
import Marketing from './Marketing.astro';
import Fotos from './Fotos.astro';
import Cifras from './Cifras.astro';
import Criterio from './Criterio.astro';
import Equipo from './Equipo.astro';
import Proyectos from './Proyectos.astro';
import Testimonios from './Testimonios.astro';
import Faq from './Faq.astro';
import Cierre from './Cierre.astro';
import SolicitudModal from './SolicitudModal.astro';
import Footer from './Footer.astro';
import { HOME, RUTA_HOME, type Idioma } from '../data/home';
import { faqJsonLd } from '../lib/jsonld';
import {
  MOSTRAR_EQUIPO,
  MOSTRAR_FAQ,
  MOSTRAR_POLITICA_IA,
  MOSTRAR_TESTIMONIOS,
} from '../lib/config';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const c = HOME[idioma];
---

<BaseLayout
  title={c.meta.titulo}
  description={c.meta.descripcion}
  path={RUTA_HOME[idioma]}
  lang={idioma}
  alternos={RUTA_HOME}
  detectarIdioma={idioma === 'es'}
>
  {
    MOSTRAR_FAQ && (
      <script
        type="application/ld+json"
        slot="head"
        set:html={JSON.stringify(faqJsonLd(c.faq.preguntas))}
      />
    )
  }

  <Header idioma={idioma} />
  <main>
    <Hero idioma={idioma} />
    <Franja idioma={idioma} />
    <Unico idioma={idioma} />
    <Servicios idioma={idioma} />
    <Software idioma={idioma} />
    <Industrias idioma={idioma} />
    <Marketing idioma={idioma} />
    <Fotos idioma={idioma} />
    <Cifras idioma={idioma} />
    {MOSTRAR_POLITICA_IA && <Criterio idioma={idioma} />}
    {/* Equipo y testimonios están apagados y solo tienen texto en español. */}
    {MOSTRAR_EQUIPO && idioma === 'es' && <Equipo />}
    <Proyectos idioma={idioma} />
    {MOSTRAR_TESTIMONIOS && idioma === 'es' && <Testimonios />}
    {
      MOSTRAR_FAQ && (
        <div class="faq-home tema-claro" id="faq">
          <Faq preguntas={c.faq.preguntas} rotulo={c.faq.rotulo} titulo={c.faq.titulo} />
        </div>
      )
    }
    <Cierre idioma={idioma} />
  </main>
  <Footer idioma={idioma} />
  <SolicitudModal idioma={idioma} />
</BaseLayout>

<style>
  .faq-home {
    background: var(--claro-bg);
    padding: var(--pad-y) var(--pad-x);
  }
</style>
