---
import { Image } from 'astro:assets';
import logo from '../assets/logo-ojos-publicitarios.png';

interface Props {
  /** 'header' = 30px, 'footer' = 24px */
  variante?: 'header' | 'footer';
}

const { variante = 'header' } = Astro.props;
const lado = variante === 'header' ? 30 : 24;
---

<div class:list={['logo', variante]}>
  <Image
    src={logo}
    alt=""
    width={lado}
    height={lado}
    densities={[1, 2]}
    loading="eager"
    class="marca"
  />
  <div class="palabra">OJOS<span>PUBLICITARIOS</span></div>
</div>

<style>
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .marca {
    display: block;
    flex: none;
    border-radius: 50%;
  }

  .palabra {
    font-family: var(--fuente-titulo);
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--texto);
    white-space: nowrap;
  }

  .palabra span {
    font-weight: 400;
    color: var(--texto-tenue);
  }

  .header .palabra {
    font-size: 15px;
  }

  .footer .palabra {
    font-size: 13px;
  }

  /* En pantallas angostas se achica la palabra antes que recortarla. */
  @media (max-width: 440px) {
    .header .palabra {
      font-size: 13px;
    }
  }

  @media (max-width: 360px) {
    .header .palabra span {
      display: none;
    }
  }
</style>
