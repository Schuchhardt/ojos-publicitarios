---
import { Image } from 'astro:assets';
import ojo from '../assets/web/ojo.png';

interface Props {
  /** 'header' = ojo de 30px de alto, 'footer' = 20px. */
  variante?: 'header' | 'footer';
  /** Línea bajo la palabra ("Estudio creativo & Digital"). */
  bajada?: string;
}

const { variante = 'header', bajada } = Astro.props;
const alto = variante === 'header' ? 30 : 20;
const ancho = Math.round((alto * ojo.width) / ojo.height);
---

<div class:list={['logo', variante]}>
  <Image
    src={ojo}
    alt=""
    width={ancho}
    height={alto}
    densities={[1, 2]}
    loading="eager"
    class="marca"
  />
  <div class="textos">
    <div class="palabra">OJOS<span>PUBLICITARIOS</span></div>
    {bajada && <div class="bajada">{bajada}</div>}
  </div>
</div>

<style>
  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--claro-texto);
  }

  .marca {
    display: block;
    flex: none;
  }

  .palabra {
    font-family: var(--fuente-titulo);
    font-weight: 700;
    letter-spacing: -0.01em;
    white-space: nowrap;
    line-height: 1.1;
  }

  .palabra span {
    font-weight: 400;
  }

  .bajada {
    font-family: var(--fuente-texto);
    font-size: 11.5px;
    font-weight: 600;
    margin-top: 2px;
    white-space: nowrap;
  }

  .header .palabra {
    font-size: 17px;
  }

  .footer .palabra {
    font-size: 12px;
  }

  @media (max-width: 440px) {
    .header .palabra {
      font-size: 14px;
    }

    .bajada {
      font-size: 10px;
    }
  }

  @media (max-width: 360px) {
    .header .palabra span,
    .bajada {
      display: none;
    }
  }
</style>
