---
import '@fontsource-variable/inter';
import '../styles/ludrimar.css';

interface Props {
  title: string;
  description: string;
  /** Texto de la barra de propuesta. Vacío = sin barra (índice de propuestas). */
  cliente?: string;
  nota?: string;
  /** Idioma del contenido de la propuesta. */
  lang?: string;
  /**
   * Manda a la versión en español a quien tenga el navegador en español. Solo
   * en la versión por defecto, para no armar un ida y vuelta entre las dos.
   */
  detectarIdioma?: boolean;
}

const {
  title,
  description,
  cliente,
  nota,
  lang = 'es',
  detectarIdioma = false,
} = Astro.props;

// Ojo: dentro de un <script> de Astro el contenido es texto plano. Se inyecta
// con set:html para que salga como código y no impreso tal cual.
const scriptIdioma = `(function () {
  try {
    if (localStorage.getItem('lud-idioma')) return;
    if ((navigator.language || '').toLowerCase().indexOf('es') === 0) {
      location.replace('/propuestas/ludrimar/es/');
    }
  } catch (e) {}
})();`;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0c2339" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Propuesta privada: fuera de buscadores y de sus resúmenes. -->
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <slot name="head" />
    {detectarIdioma && <script is:inline set:html={scriptIdioma} />}
    <style>
      html {
        scroll-behavior: smooth;
      }
      body {
        margin: 0;
        background: #0c2339;
      }
      * {
        box-sizing: border-box;
      }
      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }
    </style>
  </head>
  <body>
    <slot />
    {
      cliente && (
        <div class="barra">
          <div class="barra-izq">
            <span class="punto" aria-hidden="true" />
            <strong>Propuesta de sitio</strong>
            <span class="barra-sep" aria-hidden="true">·</span>
            <span>{cliente}</span>
          </div>
          {nota && <div class="barra-nota">{nota}</div>}
        </div>
      )
    }

    <style>
      .barra {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 12px 24px;
        padding: 12px clamp(20px, 5vw, 72px);
        background: #06111a;
        color: #b8c9d2;
        font-family: 'Inter Variable', system-ui, sans-serif;
        font-size: 12.5px;
        line-height: 1.5;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
      }

      .barra-izq {
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .barra strong {
        color: #e8f1f4;
        font-weight: 600;
      }

      .punto {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #00c8e6;
        flex: none;
      }

      .barra-sep {
        opacity: 0.5;
      }

      .barra-nota {
        color: #7e97a5;
      }

    </style>
  </body>
</html>
