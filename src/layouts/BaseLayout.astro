---
import Seo from '../components/Seo.astro';
import Animaciones from '../components/Animaciones.astro';
// Fuentes servidas desde el propio dominio: Astro las versiona y Netlify las
// cachea para siempre. Evita dos conexiones extra a Google en cada visita.
import '@fontsource-variable/space-grotesk/wght.css';
import '@fontsource-variable/archivo/standard.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import { SERVICIOS } from '../data/contenido';
import {
  CONTACTO_EMAIL,
  MARCA,
  REDES,
  TAGLINE,
  TIENE_EMAIL,
  TIENE_WHATSAPP,
  WHATSAPP_DISPLAY,
} from '../lib/config';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publicado?: Date;
  actualizado?: Date;
  autor?: string;
}

const { title, description, path, image, type, noindex, publicado, actualizado, autor } =
  Astro.props;

const contacto: Record<string, unknown>[] = [];
if (TIENE_WHATSAPP) {
  contacto.push({
    '@type': 'ContactPoint',
    contactType: 'ventas',
    telephone: WHATSAPP_DISPLAY,
    availableLanguage: ['es'],
  });
}
if (TIENE_EMAIL) {
  contacto.push({ '@type': 'ContactPoint', contactType: 'ventas', email: CONTACTO_EMAIL });
}

const perfiles = REDES.filter((red) => red.icono !== 'whatsapp').map((red) => red.url);
const logo = new URL('/logo-ojos-publicitarios.png', Astro.site).toString();

// Ficha del negocio con @id estable: los artículos del blog la referencian como
// autor y editor en vez de repetir los datos.
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': new URL('/#negocio', Astro.site).href,
  name: MARCA,
  slogan: TAGLINE,
  description:
    'Estudio creativo y digital chileno: diseño de páginas web, tiendas online, identidad de marca y automatización de la atención a clientes.',
  url: Astro.site?.toString(),
  logo,
  image: new URL('/og-image.jpg', Astro.site).toString(),
  ...(TIENE_EMAIL ? { email: CONTACTO_EMAIL } : {}),
  ...(TIENE_WHATSAPP ? { telephone: WHATSAPP_DISPLAY } : {}),
  areaServed: { '@type': 'Country', name: 'Chile' },
  availableLanguage: { '@type': 'Language', name: 'Español' },
  knowsAbout: [
    'Diseño de páginas web',
    'Landing pages',
    'Sitios corporativos',
    'Tiendas online',
    'Automatización de la atención por WhatsApp',
    'Identidad de marca',
    'Publicidad exterior',
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servicios',
    itemListElement: SERVICIOS.map((servicio) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: servicio.titulo,
        description: servicio.descripcion,
        areaServed: { '@type': 'Country', name: 'Chile' },
      },
    })),
  },
  ...(contacto.length > 0 ? { contactPoint: contacto } : {}),
  ...(perfiles.length > 0 ? { sameAs: perfiles } : {}),
};

const sitioJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': new URL('/#sitio', Astro.site).href,
  name: MARCA,
  url: Astro.site?.toString(),
  inLanguage: 'es-CL',
  publisher: { '@id': new URL('/#negocio', Astro.site).href },
};
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#06111a" />

    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <Seo
      title={title}
      description={description}
      path={path}
      image={image}
      type={type}
      noindex={noindex}
      publicado={publicado}
      actualizado={actualizado}
      autor={autor}
    />

    <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(sitioJsonLd)} />
    <slot name="head" />

    <!-- Habilita los estados iniciales de las animaciones. Va antes del
         primer pintado para que no haya parpadeo. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <!--
      Capa de analytics agnóstica: empuja eventos a window.dataLayer.
      Si mañana se conecta GTM o GA4, los eventos ya están emitidos y nombrados.
    -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.track = function (event, params) {
        window.dataLayer.push(Object.assign({ event: event }, params || {}));
      };
      document.addEventListener('click', function (e) {
        var el = e.target instanceof Element ? e.target.closest('[data-track]') : null;
        if (!el) return;
        window.track(el.getAttribute('data-track'), {
          label: el.getAttribute('data-track-label') || el.textContent.trim().slice(0, 80),
        });
      });
    </script>
  </head>
  <body>
    <slot />
    <Animaciones />
  </body>
</html>
