---
import Seo from '../components/Seo.astro';
import Animaciones from '../components/Animaciones.astro';
// Fuentes servidas desde el propio dominio: Astro las versiona y Netlify las
// cachea para siempre. Evita dos conexiones extra a Google en cada visita.
import '@fontsource-variable/montserrat/wght.css';
import '@fontsource-variable/manrope/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import JsonLdNegocio from '../components/JsonLdNegocio.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publicado?: Date;
  actualizado?: Date;
  autor?: string;
  lang?: 'es' | 'en';
  /** Ruta de la misma página en cada idioma (hreflang). */
  alternos?: Partial<Record<'es' | 'en', string>>;
}

const {
  title,
  description,
  path,
  image,
  type,
  noindex,
  publicado,
  actualizado,
  autor,
  lang = 'es',
  alternos,
} = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />

    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <Seo
      title={title}
      description={description}
      path={path}
      image={image}
      type={type}
      noindex={noindex}
      publicado={publicado}
      actualizado={actualizado}
      autor={autor}
      lang={lang}
      alternos={alternos}
    />

    <JsonLdNegocio />
    <slot name="head" />

    <!-- Habilita los estados iniciales de las animaciones. Va antes del
         primer pintado para que no haya parpadeo. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <!--
      Capa de analytics agnóstica: empuja eventos a window.dataLayer.
      Si mañana se conecta GTM o GA4, los eventos ya están emitidos y nombrados.
    -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.track = function (event, params) {
        window.dataLayer.push(Object.assign({ event: event }, params || {}));
      };
      document.addEventListener('click', function (e) {
        var el = e.target instanceof Element ? e.target.closest('[data-track]') : null;
        if (!el) return;
        window.track(el.getAttribute('data-track'), {
          label: el.getAttribute('data-track-label') || el.textContent.trim().slice(0, 80),
        });
      });
    </script>
  </head>
  <body>
    <slot />
    <Animaciones />
  </body>
</html>
