---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Cifras from '../components/Cifras.astro';
import Servicios from '../components/Servicios.astro';
import Automatizacion from '../components/Automatizacion.astro';
import Criterio from '../components/Criterio.astro';
import Proceso from '../components/Proceso.astro';
import Equipo from '../components/Equipo.astro';
import Proyectos from '../components/Proyectos.astro';
import Testimonios from '../components/Testimonios.astro';
import Faq from '../components/Faq.astro';
import Contacto from '../components/Contacto.astro';
import SolicitudModal from '../components/SolicitudModal.astro';
import Footer from '../components/Footer.astro';
import { FAQ } from '../data/contenido';
import { faqJsonLd } from '../lib/jsonld';
import {
  MOSTRAR_EQUIPO,
  MOSTRAR_FAQ,
  MOSTRAR_POLITICA_IA,
  MOSTRAR_TESTIMONIOS,
} from '../lib/config';
---

<BaseLayout
  title="Diseño de páginas web y automatización en Chile | Ojos Publicitarios"
  description="Estudio creativo y digital chileno: landing pages, sitios corporativos, tiendas online y atención por WhatsApp que responde sola. Te respondemos en 12 h."
  path="/"
>
  {
    MOSTRAR_FAQ && (
      <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqJsonLd(FAQ))} />
    )
  }

  <Header />
  <main>
    <Hero />
    <Cifras />
    <Servicios />
    <Automatizacion />
    {MOSTRAR_POLITICA_IA && <Criterio />}
    <Proceso />
    {MOSTRAR_EQUIPO && <Equipo />}
    <Proyectos />
    {MOSTRAR_TESTIMONIOS && <Testimonios />}
    {
      MOSTRAR_FAQ && (
        <div class="seccion" id="faq">
          <Faq
            preguntas={FAQ}
            rotulo="PREGUNTAS FRECUENTES"
            titulo="Lo que nos preguntan antes de empezar."
          />
        </div>
      )
    }
    <Contacto />
  </main>
  <Footer />
  <SolicitudModal />
</BaseLayout>
