---
// Página de error con el mismo header, tipografía y footer que el landing.
import OjosLayout from '../layouts/OjosLayout.astro';
import EncabezadoBlog from '../components/ojos/EncabezadoBlog';
import { Pie } from '../components/ojos/secciones';
---

<OjosLayout
  title="Página no encontrada — Ojos Publicitarios"
  description="La página que buscas no existe o cambió de dirección."
  path="/404"
  noindex
>
  <EncabezadoBlog client:load idioma="es" alternos={{}} blog="/blog/" />
  <main id="top">
    <section class="error">
      <div class="rotulo">Error 404</div>
      <h1>Esta página se nos<br />perdió de <em>vista.</em></h1>
      <p>
        El enlace que seguiste no existe o cambió de dirección. Volvamos a donde sí hay algo que
        mirar.
      </p>
      <div class="botones">
        <a href="/" class="boton boton-primario" data-cursor="">Ir al inicio <span aria-hidden="true">↗</span></a>
        <a href="/#contacto" class="boton boton-secundario" data-cursor="">Hablemos</a>
      </div>
    </section>
  </main>
  <Pie idioma="es" />
</OjosLayout>

<style>
  /* Mismos tokens y tipografía que el landing (styles/ojos.css). */
  .error {
    min-height: 80vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(120px, 18vh, 180px) clamp(16px, 3vw, 44px) clamp(100px, 14vh, 160px);
  }

  .rotulo {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 24px;
  }

  h1 {
    font-size: clamp(44px, 7vw, 120px);
    font-weight: 600;
    line-height: 0.92;
    letter-spacing: -0.045em;
    margin: 0 0 32px;
    text-wrap: balance;
  }

  h1 em {
    font-family: 'Instrument Serif', serif;
    font-weight: 400;
    color: var(--accent);
  }

  p {
    font-size: clamp(18px, 1.5vw, 22px);
    line-height: 1.5;
    color: var(--soft);
    margin: 0 0 40px;
    max-width: 46ch;
    text-wrap: pretty;
  }

  .botones {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .boton {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 16px 24px;
    border-radius: 999px;
    border: 1px solid var(--ink);
    transition: background 0.25s, color 0.25s, border-color 0.25s;
  }

  .boton-primario {
    background: var(--ink);
    color: var(--bg);
  }

  .boton-primario:hover {
    background: var(--accent);
    border-color: var(--accent);
  }

  .boton-secundario {
    color: var(--ink);
  }

  .boton-secundario:hover {
    background: var(--ink);
    color: var(--bg);
  }
</style>
